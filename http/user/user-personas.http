### KNK-1482 페르소나 관리와 채팅 원문 검증
# 준비: 로컬 Postgres·AI 실행, ./gradlew bootRun, auth 로그인으로 accessToken 전역 변수 설정.
# 위에서부터 실행한다. 제출본이 APPROVED가 될 때까지 제출본 조회를 다시 실행한다.
# 실제 AI는 기본 주인공 이름 검수를 아직 지원하지 않으며, 이름 필드는 전달만 한다.
@baseUrl = http://localhost:8080

### 서버 확인
GET {{baseUrl}}/actuator/health

### 이름 토큰 스토리 제출
POST {{baseUrl}}/api/v1/stories/general
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "protagonistName":"민우",
  "title":"{username}의 귀환",
  "oneLineIntro":"{username}은(는) 길을 떠난다",
  "description":"{username}이랑(랑) 함께하는 모험",
  "genres":["판타지"],
  "visibility":"PUBLIC",
  "storySettings":{"worldSetting":"{username}의 세계","characterSetting":"동료","userRoleSetting":"기본 모험가","ruleSetting":"선택에 따라 전개"},
  "startSettings":[{"name":"{username}의 시작","prologue":"{username}은(는) 출발한다","startSituation":"{username}으로(로) 시선이 모인다","suggestedInputs":["{username}의 짐을 챙긴다","문을 연다","주변을 본다"],"endings":[{"name":"{username}의 귀환","requirement":{"minTurns":1,"achievementCondition":"여정을 마친다"},"epilogue":"{username}이(가) 돌아온다"}]}]
}

> {%
client.test("스토리 제출 202", () => client.assert(response.status === 202, `actual=${response.status}`));
client.global.set("personaSubmissionId", response.body.submissionId);
%}

### 승인까지 반복 조회, 이후 요청의 personaStoryId 준비
GET {{baseUrl}}/api/v1/stories/submissions/{{personaSubmissionId}}
Authorization: Bearer {{accessToken}}

> {%
client.test("제출본은 원문", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  client.assert(response.body.payload.title === "{username}의 귀환", "토큰 원문 보존");
  client.assert(response.body.payload.protagonistName === "민우", "기본 이름 보존");
});
if (response.body.status === "APPROVED") client.global.set("personaStoryId", response.body.storyId);
%}

### 페르소나 등록, 공백 제거
POST {{baseUrl}}/api/v1/users/me/personas
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name":" 하늘 ","description":" 과묵한 항해사 "}

> {%
client.test("페르소나 등록 201", () => {
  client.assert(response.status === 201, `actual=${response.status}`);
  client.assert(response.body.name === "하늘" && response.body.description === "과묵한 항해사", "trim된 이름과 설명");
});
client.global.set("personaId", response.body.id);
%}

### 목록, 최신순
GET {{baseUrl}}/api/v1/users/me/personas
Authorization: Bearer {{accessToken}}

> {%
client.test("페르소나 목록", () => client.assert(response.status === 200 && Array.isArray(response.body), `actual=${response.status}`));
%}

### 페르소나로 채팅 생성
POST {{baseUrl}}/api/v1/chats
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"storyId":"{{personaStoryId}}","personaId":"{{personaId}}"}

> {%
client.test("선택한 이름 표시", () => {
  client.assert(response.status === 201, `actual=${response.status}`);
  client.assert(JSON.stringify(response.body.persona) === JSON.stringify({name:"하늘"}), "페르소나는 이름만 반환");
  client.assert(response.body.prologue === "하늘은 출발한다", `actual=${response.body.prologue}`);
});
client.global.set("personaChatId", response.body.id);
%}

### 원본 수정
PATCH {{baseUrl}}/api/v1/users/me/personas/{{personaId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name":"서윤","description":"탐험가"}

> {% client.test("수정 200", () => client.assert(response.status === 200, `actual=${response.status}`)); %}

### 원본 삭제
DELETE {{baseUrl}}/api/v1/users/me/personas/{{personaId}}
Authorization: Bearer {{accessToken}}

> {% client.test("삭제 204", () => client.assert(response.status === 204, `actual=${response.status}`)); %}

### 원본 변경과 삭제 후에도 시작 snapshot 유지
GET {{baseUrl}}/api/v1/chats/{{personaChatId}}
Authorization: Bearer {{accessToken}}

> {%
client.test("기존 채팅 불변", () => {
  client.assert(response.body.persona.name === "하늘", "시작 시 이름 보존");
  client.assert(response.body.storyTitle === "하늘의 귀환", `actual=${response.body.storyTitle}`);
  client.assert(response.body.prologue === "하늘은 출발한다", `actual=${response.body.prologue}`);
});
%}

### 공유 발급
POST {{baseUrl}}/api/v1/chats/{{personaChatId}}/shares
Authorization: Bearer {{accessToken}}

> {% client.global.set("personaShareId", response.body.shareId); %}

### 익명 공유, 프로필 비노출
GET {{baseUrl}}/api/v1/shares/{{personaShareId}}

> {%
client.test("공유에는 프로필 없음", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  client.assert(!("persona" in response.body), "persona 객체 비노출");
  client.assert(response.body.prologue === "하늘은 출발한다", "원본 채팅 이름 사용");
});
%}

### 빈 PATCH 400 (삭제한 ID는 404이므로 새 활성 ID로 교체)
# 등록 요청을 다시 실행해 personaId를 새로 채운 뒤 실행한다.
PATCH {{baseUrl}}/api/v1/users/me/personas/{{personaId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

> {% client.test("빈 PATCH 400", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 필수값 검증 400
POST {{baseUrl}}/api/v1/users/me/personas
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name":" ","description":"설명"}

> {% client.test("필드 오류 400", () => client.assert(response.status === 400 && response.body.details[0].field === "name", `actual=${response.status}`)); %}

### 인증 없음 401
GET {{baseUrl}}/api/v1/users/me/personas

> {% client.test("인증 401", () => client.assert(response.status === 401, `actual=${response.status}`)); %}

### 게스트 personaId는 스토리 조회 전 401
POST {{baseUrl}}/api/v1/chats
Content-Type: application/json

{"storyId":"not-a-uuid","personaId":"not-a-uuid"}

> {% client.test("조회 전 401", () => client.assert(response.status === 401, `actual=${response.status}`)); %}

### 잘못된 UUID 404 (타인 소유·삭제 ID도 동일)
DELETE {{baseUrl}}/api/v1/users/me/personas/not-a-uuid
Authorization: Bearer {{accessToken}}

> {% client.test("통일된 404", () => client.assert(response.status === 404, `actual=${response.status}`)); %}

### 개수 상한 409
# 테스트 계정에 활성 페르소나 10개를 준비한 뒤 실행한다. 같은 이름 등록도 허용된다.
POST {{baseUrl}}/api/v1/users/me/personas
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name":"상한 검증","description":"열한 번째 등록"}

> {% client.test("상한 409", () => client.assert(response.status === 409, `actual=${response.status}`)); %}

### 자유 목록 조회
GET {{baseUrl}}/api/v1/users/me/personas
Authorization: Bearer {{accessToken}}
