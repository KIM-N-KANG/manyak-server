### 스토리 제작 임시 저장 수동 검증
# 준비: 실 Postgres·AI를 연결한 ./gradlew bootRun, http/auth 로그인으로 accessToken 설정.
# 위에서부터 실행한다. 내 초안이 0개인 회원으로 시작하면 상한 검증을 그대로 실행할 수 있다.
# 초안 이미지 키는 presign의 .../drafts/{사용자 UUID}/{파일 UUID}.{jpg|png|webp} 형태만 허용한다.
# 다른 계정의 otherAccessToken·otherDraftId, 정지 계정의 suspendedAccessToken은 별도 로그인으로 설정한다.
@baseUrl = http://localhost:8080
@draftId = 16410000-0000-4000-8000-000000000001

### 서버 확인
GET {{baseUrl}}/actuator/health

### 이미지 키 경로 검증 준비 — 내 공개 UUID
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{accessToken}}

> {%
client.test("내 공개 식별자 조회", () => client.assert(response.status === 200, `actual=${response.status}`));
client.global.set("draftUserPublicId", response.body.id);
%}

### 내 prefix여도 경로 이동 세그먼트는 400
PUT {{baseUrl}}/api/v1/users/me/story-drafts/16410000-0000-4000-8000-000000000007
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"GENERAL","stage":"GENERAL_DRAFT","schemaVersion":1,"payload":{},"thumbnailObjectKey":"thumbnails/uploaded/drafts/{{draftUserPublicId}}/../00000000-0000-4000-8000-000000000001.png"}

> {% client.test("경로 이동 400", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 중첩 인물 키의 인코딩 우회도 400
PUT {{baseUrl}}/api/v1/users/me/story-drafts/16410000-0000-4000-8000-000000000007
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"GENERAL","stage":"GENERAL_DRAFT","schemaVersion":1,"payload":{"nested":[{"image":"characters/uploaded/drafts/{{draftUserPublicId}}/%2e%2e/00000000-0000-4000-8000-000000000001.webp"}]}}

> {% client.test("인코딩 우회 400", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 신규 초안 — 미완성 입력도 저장한다
PUT {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"GENERAL","stage":"GENERAL_DRAFT","schemaVersion":1,"payload":{"form":{"title":"작성 중"}},"title":"임시 제목"}

> {%
client.test("신규 200 버전 1", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  client.assert(response.body.version === 1, `version=${response.body.version}`);
});
client.global.set("draftCreatedAt", response.body.createdAt);
client.global.set("draftUpdatedAt", response.body.updatedAt);
%}

### 같은 내용 재전송 — 잘못된 기준 버전도 허용
PUT {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":"임시 제목","payload":{"form":{"title":"작성 중"}},"schemaVersion":1,"stage":"GENERAL_DRAFT","mode":"GENERAL","baseVersion":999}

> {%
client.test("멱등 200", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  client.assert(response.body.version === 1, `version=${response.body.version}`);
  client.assert(response.body.updatedAt === client.global.get("draftUpdatedAt"), "updatedAt 변경됨");
});
%}

### 다른 내용과 잘못된 기준 버전 — 충돌
PUT {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"GENERAL","stage":"GENERAL_DRAFT","schemaVersion":1,"payload":{},"baseVersion":99}

> {%
client.test("409 충돌 details", () => {
  client.assert(response.status === 409, `actual=${response.status}`);
  client.assert(response.body.code === "DRAFT_VERSION_CONFLICT", `code=${response.body.code}`);
  client.assert(response.body.details[0].field === "version" && response.body.details[0].message === "1", "버전 details 불일치");
  client.assert(response.body.details[1].field === "updatedAt", "시각 details 누락");
});
%}

### 정상 전체 교체 — 요약 누락은 null
PUT {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"GENERAL","stage":"GENERAL_DRAFT","schemaVersion":1,"payload":{},"baseVersion":1}

> {%
client.test("갱신 버전 2 최초 시각 유지", () => {
  client.assert(response.status === 200 && response.body.version === 2, `actual=${response.status}`);
  client.assert(response.body.createdAt === client.global.get("draftCreatedAt"), "createdAt 변경됨");
});
%}

### 상세와 목록
GET {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}

> {%
client.test("상세 payload 요약 복구", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  client.assert(response.body.title === null, "누락 요약은 null");
  client.assert(response.body.generation === null, "일반 초안은 generation null");
  client.assert(Object.keys(response.body.imageUrls).length === 0, "이미지 없는 초안");
});
%}

### 목록 — 실행 중 간편 생성·완성 요청이 있으면 CREATION_REQUEST도 포함
GET {{baseUrl}}/api/v1/users/me/story-drafts
Authorization: Bearer {{accessToken}}

> {%
client.test("카드 목록 payload 제외 정렬", () => {
  client.assert(response.status === 200 && Array.isArray(response.body), `actual=${response.status}`);
  response.body.forEach((card, i) => {
    client.assert(!Object.prototype.hasOwnProperty.call(card, "payload"), "payload 노출");
    if (i) client.assert(Date.parse(response.body[i-1].createdAt) >= Date.parse(card.createdAt), "정렬 불일치");
  });
});
%}

### 잘못된 단계 — 400
PUT {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"GENERAL","stage":"STORY_DRAFT","schemaVersion":1,"payload":{}}

> {% client.test("단계 400", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 객체 아닌 payload — 400
PUT {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"GENERAL","stage":"GENERAL_DRAFT","schemaVersion":1,"payload":[]}

> {% client.test("payload 400", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 남의 draft prefix — 400, HEAD 하지 않는다
PUT {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"GENERAL","stage":"GENERAL_DRAFT","schemaVersion":1,"payload":{"nested":[{"image":"characters/uploaded/drafts/00000000-0000-4000-8000-000000000000/missing.png"}]}}

> {% client.test("prefix 400", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 미존재 생성 요청 연결 — 400
PUT {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"SIMPLE","stage":"STORY_DRAFT","schemaVersion":1,"payload":{},"generationRequestId":"00000000-0000-4000-8000-000000000000"}

> {% client.test("생성 요청 400", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 64KB 초과 — 요청 스크립트로 65537바이트 payload를 준비
< {% request.variables.set("largePayload", JSON.stringify({x: "a".repeat(65529)})); %}
PUT {{baseUrl}}/api/v1/users/me/story-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"mode":"GENERAL","stage":"GENERAL_DRAFT","schemaVersion":1,"payload":{{largePayload}}}

> {% client.test("크기 400", () => client.assert(response.status === 400 && response.body.code === "DRAFT_PAYLOAD_TOO_LARGE", `actual=${response.status}`)); %}

