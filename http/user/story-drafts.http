Content-Type: application/json

{"draftId":"{{draftId}}","title":"임시 저장에서 등록","oneLineIntro":"소개","genres":["판타지"],"storySettings":{"worldSetting":"세계","characterSetting":"인물","userRoleSetting":"역할","ruleSetting":"규칙"},"startSettings":[{"name":"시작","prologue":"도입","startSituation":"상황","suggestedInputs":["하나","둘","셋"]}]}

