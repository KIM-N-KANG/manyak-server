### 스토리 검증 준비 — 전용 오리지널 초안 생성
# MANYAK_OFFICIAL_USER_PUBLIC_ID에 공식 회원 설정 필요 (originals.http와 같은 준비).
POST {{baseUrl}}/api/v1/admin/originals
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"title":"푸시 이동 검증 스토리","reason":"캠페인 스토리 검증"}

> {%
    client.test("스토리 준비", () => client.assert(response.status === 201, `actual=${response.status}`));
    if (response.status === 201) client.global.set("campaignStoryId", response.body.storyId);
%}

