### 19. 검색·종류·상태 AND 필터 (위에서 취소한 예약)
GET {{baseUrl}}/api/v1/admin/push/campaigns?q={{campaignId}}&kind=MARKETING&status=CANCELED
Authorization: Bearer {{adminToken}}

> {%
    client.test("UUID 정확 검색과 필터", () => {
        client.assert(response.status === 200 && response.body.totalElements === 1, `actual=${response.status}/${JSON.stringify(response.body)}`);
        client.assert(response.body.items[0].campaignId === client.global.get("campaignId"), "캠페인 UUID 불일치");
    });
%}

### 20. 공백 정규화 제목·본문 부분 검색
GET {{baseUrl}}/api/v1/admin/push/campaigns?q=%20%20테스트%20%20%20안내%20%20&kind=MARKETING
Authorization: Bearer {{adminToken}}

> {%
    client.test("본문 부분 검색", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        client.assert(response.body.items.some(it => it.campaignId === client.global.get("campaignId")), "앞서 만든 테스트 안내 본문이 검색되어야 함");
    });
%}

### 21. 서비스 캠페인만 조회
GET {{baseUrl}}/api/v1/admin/push/campaigns?kind=SERVICE
Authorization: Bearer {{adminToken}}

> {%
    client.test("서비스 필터", () => client.assert(response.status === 200 && response.body.items.every(it => it.kind === "SERVICE"), `actual=${response.status}/${JSON.stringify(response.body)}`));
%}

### 22. deliveredMembers 전체 집계 내림차순 (페이지별 정렬 아님)
GET {{baseUrl}}/api/v1/admin/push/campaigns?sort=deliveredMembers&order=desc&page=1&size=100
Authorization: Bearer {{adminToken}}

> {%
    client.test("deliveredMembers 정렬", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        const rows = response.body.items;
        rows.forEach((row, index) => {
            client.assert(row.deliveredMembers >= 0, "결과 없는 캠페인도 0 이상");
            if (index) {
                const prev = rows[index - 1];
                client.assert(prev.deliveredMembers > row.deliveredMembers || (prev.deliveredMembers === row.deliveredMembers && prev.campaignId < row.campaignId), "집계 내림차순·동률 UUID 오름차순 필요");
            }
        });
    });
%}

