### 예약 시각 이후 확인 — SENT이며 발송 data에는 storyId·deepLink가 없어야 함
# 로컬: 테스트 기기의 FCM data 확인. 원격: 해당 campaignId의 push_outbox.payload.data 확인.
# 삭제 재검증은 별도 테스트 스토리로 공개 예약한 뒤 deleted_at을 설정하고 같은 방식으로 확인한다.
# 관리자 이력의 storyId는 유지되며 내부 FK는 stories.id다.
GET {{baseUrl}}/api/v1/admin/push/campaigns/{{hiddenStoryCampaignId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("회차 완료와 이력", () => {
        client.assert(response.status === 200 && response.body.status === "SENT", `actual=${response.status}/${JSON.stringify(response.body)}`);
        client.assert(response.body.storyId === client.global.get("campaignStoryId"), "이력의 공개 UUID 유지");
    });
%}

### 자유 조회 — 검색·종류·도달 정렬
GET {{baseUrl}}/api/v1/admin/push/campaigns?q=스토리&kind=MARKETING&sort=deliveredDevices&order=desc&page=1&size=20
Authorization: Bearer {{adminToken}}

### 자유 조회 — 실패 캠페인 식별자를 실제 값으로 바꾼 뒤 재실행
# FAILED에서만 허용, 결과 컬럼은 다음 회차 종료까지 유지한다.
@failedCampaignId = 00000000-0000-4000-8000-000000000001
POST {{baseUrl}}/api/v1/admin/push/campaigns/{{failedCampaignId}}/retry
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"reason":"발송 장애 원인 해결 후 재실행"}

### 이프 만료 예정 안내 문구 조회 — 정보성, 금액·수량·충전 권유 금지
GET {{baseUrl}}/api/v1/admin/push/templates/credit_expiry_reminder
Authorization: Bearer {{adminToken}}

> {%
    client.test("이프 안내 키 조회", () => client.assert(response.status === 200 && response.body.templateKey === "credit_expiry_reminder",
        `expected=200/credit_expiry_reminder actual=${response.status}/${JSON.stringify(response.body)}`));
%}

### 이프 안내 즉시 변경 — 위 관리자 인증 준비 후 순서대로 실행한다
PUT {{baseUrl}}/api/v1/admin/push/templates/credit_expiry_reminder
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"title":"이프 만료 예정 안내","body":"만료 예정 이프는 이프 화면에서 확인해 주세요.","reason":"정보성 안내 문구 검증"}

> {%
    client.test("이프 문구 적용", () => client.assert(response.status === 200 && response.body.effective.isDefault === false,
        `expected=200/false actual=${response.status}/${JSON.stringify(response.body)}`));
%}

### 이프 안내 400 — 종료가 시작보다 앞선 문구
PUT {{baseUrl}}/api/v1/admin/push/templates/credit_expiry_reminder
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"title":"이프 안내","body":"본문","effectiveFrom":"2099-01-02T00:00:00Z","effectiveUntil":"2099-01-01T00:00:00Z","reason":"기간 검증"}

> {%
    client.test("이프 문구 기간 검증", () => client.assert(response.status === 400, `expected=400 actual=${response.status}`));
%}

### 이프 안내 기본 문구 복귀 — 활성·예약 행 종료
DELETE {{baseUrl}}/api/v1/admin/push/templates/credit_expiry_reminder
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"reason":"정보성 안내 검증 후 복귀"}

> {%
    client.test("이프 기본 문구 복귀", () => client.assert(response.status === 200 && response.body.effective.isDefault === true && response.body.effective.body === "곧 만료되는 이프가 있어요",
        `expected=200/default actual=${response.status}/${JSON.stringify(response.body)}`));
%}

### 이프 안내 자유 조회
GET {{baseUrl}}/api/v1/admin/push/templates/credit_expiry_reminder
Authorization: Bearer {{adminToken}}
