### 스토리를 발행·공개로 변경
PATCH {{baseUrl}}/api/v1/admin/originals/{{campaignStoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title":"푸시 이동 검증 스토리", "oneLineIntro":"알림 이동 검증",
  "genres":["판타지"], "status":"PUBLISHED", "visibility":"PUBLIC",
  "storySettings":{"worldSetting":"세계관", "characterSetting":"등장인물", "userRoleSetting":"주인공", "ruleSetting":"규칙"},
  "startSettings":[{"name":"시작", "prologue":"프롤로그", "startSituation":"시작 상황", "suggestedInputs":["주변을 살핀다","인사를 한다","앞으로 간다"]}],
  "reason":"공개 스토리 이동 검증"
}

> {%
    client.test("공개 발행", () => client.assert(response.status === 200 && response.body.visibility === "PUBLIC", `actual=${response.status}`));
%}

### 공개 스토리로 즉시 예약 — 테스트 수신자·스케줄러 설정 후 실행
# 수신자는 ACTIVE + 광고 동의 + 토큰 보유, 야간은 야간 동의도 필요.
# 다음 폴링 후 로컬 FCM data 또는 원격 push_outbox.payload.data에서
# storyId={{campaignStoryId}}, deepLink=https://manyak.app/stories/{{campaignStoryId}}?utm_source=push&utm_medium=push&utm_campaign={예약 응답 campaignId}&utm_content=promotion 확인.
# UTM 순서는 source·medium·campaign·content. campaign 값은 스토리 ID가 아닌 캠페인 공개 UUID.
# 공지 캠페인은 /notices/{noticeId}와 같은 UTM을 사용하며 SERVICE는 content=notice, MARKETING은 content=promotion.
POST {{baseUrl}}/api/v1/admin/push/campaigns
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"title":"스토리 공개 이동 검증","body":"스토리를 만나보세요","storyId":"{{campaignStoryId}}","reason":"공개 딥링크 검증"}

> {%
    client.test("공개 UUID 응답", () => client.assert(response.status === 201 && response.body.storyId === client.global.get("campaignStoryId"), `actual=${response.status}/${JSON.stringify(response.body)}`));
    if (response.status === 201) client.global.set("storyCampaignId", response.body.campaignId);
%}

