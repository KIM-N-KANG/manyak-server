# 알림 열람: ADMIN BACKEND 4-1-24~25·4-2-36·4-2-42, KNK-1927·KNK-1966
# 준비: 로컬 PostgreSQL·Redis 기동 후 ./gradlew bootRun. auth.http에서 관리자 로그인해 adminToken 준비.
# MANYAK_ADMIN_PUSH_OPENS_MEASURED_FROM은 푸시 UTM 서버를 배포한 KST 날짜(YYYY-MM-DD).
# MANYAK_ADMIN_PUSH_OPENS_APP_MEASURED_FROM은 앱 v1.7.7의 Play 배포일 KST 날짜. 빈 플랫폼은 조회하지 않는다.
# 두 설정을 모두 비우면 Amplitude 호출 없이 BEFORE_MEASUREMENT. 설정했으면 Amplitude 키와 발송 결과 데이터가 필요하다.
# 아래 from/to를 오늘 이하로 조정하고 위에서부터 실행. 실제 서버에서는 Amplitude 예산을 소비할 수 있음.
# 캠페인은 마지막 started_at이 범위 안인 항목만, activityTypes는 이프 만료 예정 안내를 포함한 고정 4종. 웹과 앱의 푸시 및 알림함 열람을 각각 조회한다. 이프 만료 예정은 알림함 클릭도 push UTM이라 푸시 열람에 포함된다.
@baseUrl = http://localhost:8080
@adminToken = PUT_AN_ADMIN_TOKEN_HERE
@from = 2026-10-18
@to = 2026-10-24

### 0. 상태 확인
GET {{baseUrl}}/actuator/health

> {%
    client.test("서버 정상", () => client.assert(response.status === 200, `actual=${response.status}`));
%}

### 1. 기본 최근 7일 : 날짜별 고유 사용자 수의 합, 1 초과 열람률 허용
GET {{baseUrl}}/api/v1/admin/campaigns/push-opens
Authorization: Bearer {{adminToken}}

> {%
    client.test("푸시 열람 계약", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        const b = response.body;
        client.assert(Array.isArray(b.pendingDates) && Array.isArray(b.campaigns), JSON.stringify(b));
        client.assert(!("serviceTypes" in b), "activityTypes를 사용해야 합니다");
        client.assert(JSON.stringify(b.activityTypes.map(t => t.type)) === JSON.stringify(["STORY_COMPLETED", "STORY_MODERATION_COMPLETED", "ATTENDANCE_REMINDER", "CREDIT_EXPIRY_REMINDER"]), JSON.stringify(b.activityTypes));
        const states = ["MEASURED", "BEFORE_MEASUREMENT", "NO_LINK", "PENDING"];
        b.campaigns.forEach(c => {
            client.assert(states.includes(c.openState), JSON.stringify(c));
            if (c.openState !== "MEASURED") client.assert(["pushOpens", "webPushOpens", "androidPushOpens", "inboxOpens", "webInboxOpens", "androidInboxOpens", "pushOpenRate"].every(k => c[k] === null), JSON.stringify(c));
            else {
                client.assert(c.pushOpens === (c.webPushOpens || 0) + (c.androidPushOpens || 0), JSON.stringify(c));
                client.assert(c.inboxOpens === (c.webInboxOpens || 0) + (c.androidInboxOpens || 0), JSON.stringify(c));
            }
            client.assert(!("inboxOpenRate" in c), JSON.stringify(c));
            if (c.deliveredMembers === 0) client.assert(c.pushOpenRate === null, JSON.stringify(c));
        });
        [...b.campaigns, ...b.activityTypes].forEach(row => {
            const fields = ["chattedMembers", "chattedBeforeMembers", "chatRate"];
            client.assert(fields.every(key => key in row), `채팅 전환 필드 누락 actual=${JSON.stringify(row)}`);
            if (row.deliveredMembers === 0) client.assert(fields.every(key => row[key] === null), `도달 0 actual=${JSON.stringify(row)}`);
            else {
                client.assert(Number.isInteger(row.chattedMembers) && Number.isInteger(row.chattedBeforeMembers), JSON.stringify(row));
                client.assert(row.chattedMembers >= 0 && row.chattedMembers <= row.deliveredMembers && row.chattedBeforeMembers >= 0 && row.chattedBeforeMembers <= row.deliveredMembers, JSON.stringify(row));
                client.assert(Math.abs(row.chatRate - row.chattedMembers / row.deliveredMembers) < 1e-10, JSON.stringify(row));
            }
        });
        client.assert("androidMeasuredFrom" in b, JSON.stringify(b));
        if (b.campaigns.length) client.global.set("pushOpenCampaignId", b.campaigns[0].campaignId);
        if (b.measuredFrom === null && b.androidMeasuredFrom === null) {
            client.assert(b.asOf === null && b.activityFrom === null && b.pendingDates.length === 0, JSON.stringify(b));
            client.assert(b.activityTypes.every(t => t.openState === "BEFORE_MEASUREMENT" && t.pushOpens === null), JSON.stringify(b));
        }
    });
%}

### 2. 명시 범위 : 측정 시작일 이전은 pendingDates에 포함하지 않음
GET {{baseUrl}}/api/v1/admin/campaigns/push-opens?from={{from}}&to={{to}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("명시 범위", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        const b = response.body;
        const starts = [b.measuredFrom, b.androidMeasuredFrom].filter(Boolean).sort();
        if (starts.length) client.assert(b.pendingDates.every(d => d >= starts[0]), JSON.stringify(b.pendingDates));
    });
%}

