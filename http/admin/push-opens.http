### 7. 자유 조회 : 준비 날짜를 조정해 직접 확인
GET {{baseUrl}}/api/v1/admin/campaigns/push-opens?from={{from}}&to={{to}}
Authorization: Bearer {{adminToken}}

### 8. 캠페인 하나 열람: 위 목록에 캠페인이 있을 때 실행
# 목록과 같은 저장 값을 쓰고 마지막 startedAt의 KST 날짜부터 최대 366일을 집계한다.
GET {{baseUrl}}/api/v1/admin/campaigns/push-opens/{{pushOpenCampaignId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("캠페인 열람", () => {
        const b = response.body;
        client.assert(response.status === 200 && b.campaignId === client.global.get("pushOpenCampaignId"), JSON.stringify(b));
        client.assert(Array.isArray(b.pendingDates) && "androidMeasuredFrom" in b, JSON.stringify(b));
        const conversionFields = ["chattedMembers", "chattedBeforeMembers", "chatRate"];
        client.assert(conversionFields.every(key => key in b), `채팅 전환 필드 누락 actual=${JSON.stringify(b)}`);
        if (b.deliveredMembers === 0) client.assert(conversionFields.every(key => b[key] === null), JSON.stringify(b));
        else {
            client.assert(Number.isInteger(b.chattedMembers) && Number.isInteger(b.chattedBeforeMembers), JSON.stringify(b));
            client.assert(Math.abs(b.chatRate - b.chattedMembers / b.deliveredMembers) < 1e-10, JSON.stringify(b));
        }
        if (b.startedAt === null) client.assert(b.openState === "PENDING" && b.from === null && b.to === null && b.deliveredMembers === 0, JSON.stringify(b));
        if (b.openState !== "MEASURED") client.assert(b.asOf === null && b.pendingDates.length === 0 && b.pushOpens === null && b.inboxOpens === null, JSON.stringify(b));
        else {
            client.assert(b.pushOpens === (b.webPushOpens || 0) + (b.androidPushOpens || 0), JSON.stringify(b));
            client.assert(b.inboxOpens === (b.webInboxOpens || 0) + (b.androidInboxOpens || 0), JSON.stringify(b));
        }
    });
%}

### 9. 없는 캠페인 404
GET {{baseUrl}}/api/v1/admin/campaigns/push-opens/00000000-0000-4000-8000-000000000000
Authorization: Bearer {{adminToken}}

> {%
    client.test("없는 캠페인", () => client.assert(response.status === 404, `actual=${response.status}`));
%}

