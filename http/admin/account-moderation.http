### 자유 조회 — 로컬 데이터 기준으로 페이지·정렬을 바꿔 확인
GET {{baseUrl}}/api/v1/admin/moderation/holds?page=1&size=100&sort=heldAt&order=asc
Authorization: Bearer {{adminToken}}

### 검수 제출본 전체 목록 — 기존 보류 API와 별개인 읽기 전용 경로
# 같은 정렬 값(함께 null 포함)은 공개 UUID asc이며 size=2로 페이지를 넘겨 중복·누락을 확인한다.
# 준비: story/story-general-create.http로 로컬 제출본을 만들거나 기존 제출본이 있는 DB를 사용한다.
# 위 관리자 로그인 요청만 먼저 실행하면 된다. 계정 정지·보류 해제 요청 실행은 필요 없다.
GET {{baseUrl}}/api/v1/admin/moderation/submissions?page=1&size=20
Authorization: Bearer {{adminToken}}

> {%
client.test("제출본 목록과 안전한 회원 요약", () => {
    client.assert(response.status === 200, `expected=200 actual=${response.status}`);
    client.assert(Array.isArray(response.body.items) && response.body.page === 1, "items/page 구조");
    response.body.items.forEach(item => {
        client.assert(["PENDING","HELD","APPROVED","REJECTED","FAILED"].includes(item.status), "관리자 제출 상태");
        client.assert(typeof item.owner.isAdmin === "boolean" && !!item.owner.memberId, "공통 회원 요약");
        client.assert(!("payload" in item) && !("inputForm" in item) && !("id" in item), "원문/내부 식별자 노출 금지");
    });
});
if (response.status === 200 && response.body.items.length > 0) client.global.set("moderationSubmissionId", response.body.items[0].submissionId);
%}

### 제출본 상세 — 위 목록에 적어도 한 건 필요, 또는 moderationSubmissionId 직접 지정
GET {{baseUrl}}/api/v1/admin/moderation/submissions/{{moderationSubmissionId}}
Authorization: Bearer {{adminToken}}

> {%
client.test("선택한 필드만 반환하고 감사 기록을 남기지 않는 조회", () => {
    client.assert(response.status === 200, `expected=200 actual=${response.status}`);
    client.assert(!!response.body.submissionId && !!response.body.fields.title, "상세 필드");
    client.assert(Array.isArray(response.body.issues) && Array.isArray(response.body.imageResults), "위반과 이미지 결과");
    response.body.imageResults.forEach(image => {
        client.assert(["APPROVED","REJECTED","ERROR","PENDING"].includes(image.moderationStatus), "폼 값과 무관한 이미지 검수 결과");
        client.assert(image.moderationStatus === "ERROR" ? typeof image.errorCode === "string" : image.errorCode === null, "ERROR만 이미지 오류 코드");
    });
    client.assert(Object.keys(response.body.fields).every(k => ["title","oneLineIntro","description","protagonistName","genres","visibility","characterNames"].includes(k)), "허용 필드만");
    client.assert(!("payload" in response.body) && !("imageCopies" in response.body), "원문과 복사 매핑 없음");
});
%}

### 보류 아닌 대기만 — HELD와 겹치지 않음
