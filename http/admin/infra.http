# 관리자 인프라 지표 — ADMIN BACKEND 4-2-34(지표), 4-2-35(DB 테이블), KNK-2113 출처 개편
# 출처 셋을 나란히 부른다: CloudWatch(앱 호스트 4, RDS 5 질의), 관측 서버 Prometheus(기록 규칙 계열), Redis(INFO, DBSIZE).
# 준비: 로컬 PostgreSQL/Redis 기동 후 ./gradlew bootRun, 관리자 로그인으로 ADMIN 토큰 발급.
# adminToken/rolelessAdminToken은 http/admin/auth.http에서 준비한 값으로 교체한다.
# 기본 개발 환경은 CloudWatch, Prometheus 설정이 비어 redis 묶음만 값이 있다(200). db-tables=200.
# 전체 묶음 확인은 6-3의 MANYAK_ADMIN_INFRA_HOST_ASG, ..._RDS_INSTANCE, ..._PROMETHEUS_* 와 AWS 역할 자격이 있는 환경에서만 수동 실행한다.
# MANYAK_ADMIN_INFRA_HOST_SOURCE=prometheus(KNK-2126, OCI 운영 호스트)면 CloudWatch를 부르지 않고 host와 rds도 Prometheus 기록 규칙 계열에서 채운다.
# 응답 모양은 같고 host.cpuCreditBalance는 늘 빈 목록이다. 이때는 AWS 자격 없이 ..._PROMETHEUS_* 만 있으면 전체 묶음이 나온다.
# 그 요청은 실제 AWS와 관측 서버를 부르므로 필요할 때만 개별 실행한다. 자동 테스트는 대역만 사용한다.
# 캐시 비교 요청은 바로 위 요청부터 순서대로, metrics는 60초/DB는 5분 안에 실행한다.
@baseUrl = http://localhost:8080
@adminToken = REPLACE_ADMIN_TOKEN
@rolelessAdminToken = REPLACE_ROLELESS_ADMIN_TOKEN
@from = 2026-10-22
@to = 2026-10-23

### 기동 확인
GET {{baseUrl}}/actuator/health

> {%
client.test("서버 기동", () => client.assert(response.status === 200, `actual=${response.status}`));
%}

### 기본 KST 오늘, 300초 간격. 설정된 묶음만 값이 있고 실패한 출처의 묶음은 null + unavailable
GET {{baseUrl}}/api/v1/admin/infra/metrics
Authorization: Bearer {{adminToken}}

> {%
client.test("인프라 응답 계약", () => {
    client.assert(response.status === 200, `actual=${response.status}`);
    const b = response.body;
    client.assert(b.from === b.to && b.periodSeconds === 300, JSON.stringify(b));
    client.assert(Number.isFinite(Date.parse(b.asOf)), `asOf=${b.asOf}`);
    const keys = ["host", "hostSystem", "requests", "rds", "redis", "opensearch"];
    keys.forEach(k => client.assert(k in b, `묶음 키 ${k} 없음`));
    client.assert(Array.isArray(b.unavailable) && b.unavailable.every(k => keys.includes(k) && b[k] === null), `unavailable=${b.unavailable}`);
    const series = [];
    if (b.host !== null) series.push(b.host.cpu, b.host.cpuMax, b.host.cpuCreditBalance, b.host.statusCheckFailed);
    if (b.hostSystem !== null) {
        series.push(b.hostSystem.memoryAvailableBytes);
        const mounts = b.hostSystem.disks.map(d => d.mount);
        client.assert(JSON.stringify(mounts) === JSON.stringify([...mounts].sort()), `디스크 오름차순 ${mounts}`);
        b.hostSystem.disks.forEach(d => series.push(d.availableBytes));
    }
    if (b.requests !== null) series.push(b.requests.requests, b.requests.server5xx, b.requests.responseTimeP95Ms);
    if (b.rds !== null) series.push(b.rds.cpu, b.rds.freeStorageBytes, b.rds.connections, b.rds.readLatencyMs, b.rds.writeLatencyMs);
    if (b.opensearch !== null) {
        client.assert([null, "green", "yellow", "red"].includes(b.opensearch.status), `status=${b.opensearch.status}`);
        series.push(b.opensearch.diskAvailableBytes, b.opensearch.jvmMemoryPressure);
    }
    if (b.redis !== null) ["usedMemoryBytes", "maxMemoryBytes", "connectedClients", "keys"].forEach(k =>
        client.assert(Number.isInteger(b.redis[k]) && b.redis[k] >= 0, `redis.${k}=${b.redis[k]}`));
    series.forEach(points => points.forEach((p, i) => {
        client.assert(Number.isFinite(p.value), JSON.stringify(p));
        if (i > 0) client.assert(Date.parse(points[i - 1].at) < Date.parse(p.at), "점 오름차순");
    }));
    if (b.requests !== null) [b.requests.requests, b.requests.server5xx].forEach(points =>
        points.forEach(p => client.assert(Number.isInteger(p.value), `건수는 정수: ${JSON.stringify(p)}`)));
    client.global.set("infraAsOf", b.asOf);
});
%}

### 바로 재조회: 캐시 생성 시각 유지 (위 요청 후 60초 이내)
GET {{baseUrl}}/api/v1/admin/infra/metrics
Authorization: Bearer {{adminToken}}

> {%
client.test("응답 캐시 asOf", () => {
    client.assert(response.status === 200, `actual=${response.status}`);
    client.assert(response.body.asOf === client.global.get("infraAsOf"), `asOf=${response.body.asOf}`);
});
%}

### PostgreSQL: 기본 limit=20, 전체 대상 테이블 수와 DB 크기
GET {{baseUrl}}/api/v1/admin/infra/db-tables
Authorization: Bearer {{adminToken}}

> {%
client.test("DB 테이블 크기 계약", () => {
    client.assert(response.status === 200, `actual=${response.status}`);
    const b = response.body;
    client.assert(b.databaseBytes > 0 && b.tableCount >= b.tables.length && b.tables.length <= 20, JSON.stringify(b));
    b.tables.forEach((t, i) => {
        client.assert(!["pg_catalog", "information_schema", "pg_toast"].includes(t.schema), t.schema);
        client.assert(t.totalBytes >= t.tableBytes + t.indexBytes && t.estimatedRows >= 0, JSON.stringify(t));
        if (i > 0) client.assert(b.tables[i - 1].totalBytes >= t.totalBytes, "크기 내림차순");
    });
    client.global.set("infraDbAsOf", b.asOf);
});
%}

### 바로 재조회: DB 캐시 (위 요청 후 5분 이내)
GET {{baseUrl}}/api/v1/admin/infra/db-tables
Authorization: Bearer {{adminToken}}

> {%
client.test("DB 캐시 asOf", () => {
    client.assert(response.status === 200, `actual=${response.status}`);
    client.assert(response.body.asOf === client.global.get("infraDbAsOf"), `asOf=${response.body.asOf}`);
});
%}

