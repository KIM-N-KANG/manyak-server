### 자유 조회 — 실제 DB의 검색어·페이지·필터를 직접 바꿔 실행
GET {{baseUrl}}/api/v1/admin/members?q=등대&page=1&size=20
Authorization: Bearer {{adminToken}}


### 차트 — 7일, 분포 8종, 빈 날짜는 0
# 아래 막대·목록 수 비교는 MANYAK_ADMIN_DASHBOARD_EXCLUDED_USER_IDS를 빈 값으로 기동한 환경에서 실행한다.
# 채팅 분포는 삭제된 스토리에 남은 미삭제 채팅도 포함한다. 장르 깊이는 삭제 스토리를 제외한다.
# 비교 중 데이터가 바뀌지 않는 로컬 fixture를 사용한다.
GET {{baseUrl}}/api/v1/admin/dashboard/charts?days=7
Authorization: Bearer {{adminToken}}

> {%
    client.test("차트 계약", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(response.body.daily.length === 7 && response.body.distributions.length === 8, "7일과 8개 차트가 필요합니다");
        client.assert(response.body.distributions[1].points.length === 11, "턴 구간 11개가 필요합니다");
        const link = response.body.distributions[1].points[1].link;
        client.assert(link.list === "chats" && link.params.turnBucket === "1", `actual=${JSON.stringify(link)}`);
    });
    if (response.status === 200) {
        for (const [chartId, prefix] of [["turns", "adminTurnDrill"], ["member-chats", "adminMemberDrill"], ["characters", "adminCharactersDrill"]]) {
            const points = response.body.distributions.find(d => d.chartId === chartId).points;
            const point = points.find(p => p.value > 0) || points[0];
            const query = Object.entries(point.link.params).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join("&");
            client.global.set(`${prefix}Path`, `${point.link.list}?${query}`);
            client.global.set(`${prefix}Count`, point.value);
        }
        const genre = response.body.distributions.find(d => d.chartId === "genre-depth").points[0];
        if (genre) {
            const query = Object.entries(genre.link.params).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join("&");
            client.global.set("adminGenreDrillPath", `${genre.link.list}?${query}&size=100`);
            client.global.set("adminGenreAverage", genre.value);
        }
    }
%}

