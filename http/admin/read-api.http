### 차트 — 7일, 분포 9종, 빈 날짜는 0
# 아래 막대·목록 수 비교는 MANYAK_ADMIN_DASHBOARD_EXCLUDED_USER_IDS를 빈 값으로 기동한 환경에서 실행한다.
# 채팅 분포는 삭제된 스토리에 남은 미삭제 채팅도 포함한다. 장르별 평균 턴 수는 삭제 스토리를 제외한다.
# 비교 중 데이터가 바뀌지 않는 로컬 fixture를 사용한다.
# 장르 소표본 fixture: 던전 1개 465턴, 로맨스 6개 합 60턴이면 던전(465,1,465), 로맨스(10,6,60) 순이다.
GET {{baseUrl}}/api/v1/admin/dashboard/charts?days=7
Authorization: Bearer {{adminToken}}

> {%
    client.test("차트 계약", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(response.body.daily.length === 7 && response.body.distributions.length === 9, "7일과 9개 차트가 필요합니다");
        const terms = [
            ["genre-depth", "장르별 평균 턴 수", "턴"],
            ["turns", "턴 수 분포", "개"],
            ["started-as", "채팅 소유자 게스트와 회원", "%"],
            ["member-chats", "회원별 채팅 생성 횟수", "명"],
            ["first-message", "첫 사용자 입력까지 걸린 시간", "초"],
            ["ai-latency", "기능별 AI 평균 호출 시간", "초"],
            ["ai-success", "기능별 AI 성공률", "%"],
            ["creation-mode", "제작 방식별 스토리 수", "개"],
            ["characters", "간편 제작별 입력 주변 인물 수", "건"]
        ];
        response.body.distributions.forEach((chart, i) => {
            client.assert(JSON.stringify([chart.chartId, chart.title, chart.unit]) === JSON.stringify(terms[i]), `차트 용어 actual=${JSON.stringify(chart)}`);
            client.assert(!/채팅방|제작 세션|AI 지연/.test(chart.description), `이전 용어 actual=${chart.description}`);
        });
        const aiFeatures = ["chat_response", "choice_generation", "chat_image", "storyline_generation", "story_completion", "chat_compact"];
        for (const id of ["ai-latency", "ai-success"]) {
            const points = response.body.distributions.find(c => c.chartId === id).points;
            client.assert(JSON.stringify(points.map(p => p.label)) === JSON.stringify(aiFeatures), `AI 기능 순서 actual=${JSON.stringify(points)}`);
            client.assert(points[2].link.list === "chats" && points[2].link.params.aiFeature === "chat_image", "이미지 AI는 채팅 목록으로 연결");
            const compact = points[5];
            client.assert(compact.link.list === "chats" && compact.link.params.aiFeature === "chat_compact", `요약 AI 링크 actual=${JSON.stringify(compact)}`);
            client.assert(compact.link.params.aiStatus === (id === "ai-latency" ? "SUCCEEDED" : "FINISHED"), `요약 AI 상태 actual=${JSON.stringify(compact.link)}`);
            if (id === "ai-latency") client.assert(compact.link.params.hasLatency === "true", "요약 지연 링크는 지연 값이 있는 성공 호출");
        }
        const genres = response.body.distributions.find(c => c.chartId === "genre-depth").points;
        genres.forEach((p, i) => {
            client.assert(Number.isInteger(p.chats) && p.chats > 0 && Number.isInteger(p.totalTurns) && p.totalTurns >= 0, `장르 표본 actual=${JSON.stringify(p)}`);
            client.assert(Math.abs(p.value - p.totalTurns / p.chats) < 1e-9, `장르 평균 actual=${JSON.stringify(p)}`);
            if (i > 0) {
                const previous = genres[i - 1];
                client.assert(previous.value > p.value || (previous.value === p.value && previous.label < p.label), `장르 정렬 actual=${JSON.stringify(genres)}`);
            }
        });
        response.body.distributions.filter(c => !["genre-depth", "started-as"].includes(c.chartId)).forEach(c => c.points.forEach(p => {
            client.assert(!("chats" in p) && !("totalTurns" in p) && !("users" in p), `장르·소유자 전용 필드 actual=${JSON.stringify(p)}`);
        }));
        // 채팅 소유자: 비율은 채팅 수 기준, users는 회원이면 소유 회원 수, 게스트면 AI 호출 기기 해시 수다.
        const owners = response.body.distributions.find(c => c.chartId === "started-as");
        client.assert(owners.description.includes("이관") && owners.description.includes("기기"), `소유자 설명 actual=${owners.description}`);
        const ownerChats = owners.points.reduce((sum, p) => sum + p.chats, 0);
        owners.points.forEach(p => {
            client.assert(Number.isInteger(p.chats) && Number.isInteger(p.users) && p.users <= p.chats && !("totalTurns" in p), `소유자 필드 actual=${JSON.stringify(p)}`);
            if (ownerChats > 0) client.assert(Math.abs(p.value - Math.round(10000 * p.chats / ownerChats) / 100) < 0.01, `소유자 비율 actual=${JSON.stringify(p)}`);
        });
        const modes = response.body.distributions.find(c => c.chartId === "creation-mode");
        client.assert(modes.category === "content" && JSON.stringify(modes.points.map(p => [p.label, p.link.list, p.link.params.creationMode])) ===
            JSON.stringify([["일반 제작", "stories", "GENERAL"], ["간편 제작", "stories", "SIMPLE"]]), `제작 방식 actual=${JSON.stringify(modes)}`);
        const turns = response.body.distributions[1].points;
        const turnLabels = ["0", "1", "2", "3", "4", "5", "6", "7~9", "10~14", "15~19", "20~29", "30~49", "50+"];
        client.assert(JSON.stringify(turns.map(p => p.label)) === JSON.stringify(turnLabels), "턴 구간 13개가 필요합니다");
        turns.forEach((p, i) => client.assert(p.link.list === "chats" && p.link.params.turnBucket === String(i), `턴 링크 actual=${JSON.stringify(p)}`));
        const link = response.body.distributions[1].points[1].link;
        client.assert(link.list === "chats" && link.params.turnBucket === "1", `actual=${JSON.stringify(link)}`);
    });
    if (response.status === 200) {
        for (const [chartId, prefix] of [["turns", "adminTurnDrill"], ["member-chats", "adminMemberDrill"], ["characters", "adminCharactersDrill"], ["creation-mode", "adminCreationModeDrill"]]) {
            const points = response.body.distributions.find(d => d.chartId === chartId).points;
            const point = points.find(p => p.value > 0) || points[0];
            const query = Object.entries(point.link.params).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join("&");
            client.global.set(`${prefix}Path`, `${point.link.list}?${query}`);
            client.global.set(`${prefix}Count`, point.value);
        }
        const genre = response.body.distributions.find(d => d.chartId === "genre-depth").points[0];
        if (genre) {
            const query = Object.entries(genre.link.params).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join("&");
            client.global.set("adminGenreDrillPath", `${genre.link.list}?${query}&size=100`);
            client.global.set("adminGenreAverage", genre.value);
        }
    }
%}

