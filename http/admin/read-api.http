### 장르 깊이의 링크 목록 — 앞 차트에 장르가 있고 해당 스토리가 100개 이하인 고정 fixture에서 실행
GET {{baseUrl}}/api/v1/admin/{{adminGenreDrillPath}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("장르 깊이는 링크 스토리의 턴 합과 채팅 수로 계산", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        client.assert(response.body.totalElements > 0 && response.body.items.length === response.body.totalElements, "비교할 스토리 전체가 한 페이지에 있어야 합니다");
        const turns = response.body.items.reduce((sum, s) => sum + s.totalTurns, 0);
        const chats = response.body.items.reduce((sum, s) => sum + s.chatCount, 0);
        client.assert(chats > 0 && Math.abs(turns / chats - Number(client.global.get("adminGenreAverage"))) < 1e-9, `turns=${turns} chats=${chats}`);
    });
%}

### 스토리 목록 — 팀 제외 없음, 비공개 포함, 삭제 제외, 공통 페이지
GET {{baseUrl}}/api/v1/admin/stories?size=20&sort=totalTurns&order=desc
Authorization: Bearer {{adminToken}}

> {%
    client.test("스토리 목록", () => client.assert(response.status === 200 && Array.isArray(response.body.items) && response.body.items.every(s => s.deletedAt === null), `actual=${JSON.stringify(response.body)}`));
    if (response.status === 200 && response.body.items.length) client.global.set("adminStoryId", response.body.items[0].storyId);
%}

### 스토리 상세 — 위 목록에 데이터가 있어야 함
GET {{baseUrl}}/api/v1/admin/stories/{{adminStoryId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("턴 도달률과 최근 채팅", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        const thresholds = [1, 2, 3, 4, 5, 6, 7, 10, 15, 20, 30, 50];
        client.assert(JSON.stringify(response.body.retention.map(p => p.turn)) === JSON.stringify(thresholds), `기준 턴 actual=${JSON.stringify(response.body.retention)}`);
        response.body.retention.forEach(p => client.assert(p.rate >= 0 && p.rate <= 1, `도달률 actual=${JSON.stringify(p)}`));
        client.assert(response.body.deletedAt === null, `기본 목록에서 고른 스토리 actual=${response.body.deletedAt}`);
        client.assert(response.body.recentChats.length <= 5 && response.body.recentChats.every(c => c.deletedAt === null), "최근 채팅은 삭제되지 않은 최대 5개입니다");
    });
%}

### 스토리 설정 — 위 목록에 데이터가 있어야 함. 현재 저장값 원문, 이미지 전부와 검수 상태, 접속 기록 없음
# 초안·비공개·게스트·오리지널 모두 대상이다. {username}은 치환하지 않고 승인 전 제출본은 반영하지 않는다.
GET {{baseUrl}}/api/v1/admin/stories/{{adminStoryId}}/settings
Authorization: Bearer {{adminToken}}

> {%
    client.test("스토리 설정 계약", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        const b = response.body;
        const keys = ["title", "oneLineIntro", "description", "protagonistName", "genres", "storySettings", "startSettings",
            "mainEvents", "visibility", "thumbnailUrl", "thumbnailModerationStatus", "characters", "deletedAt"];
        client.assert(JSON.stringify(Object.keys(b).sort()) === JSON.stringify(keys.slice().sort()), `필드 actual=${JSON.stringify(Object.keys(b))}`);
        client.assert(["worldSetting", "characterSetting", "userRoleSetting", "ruleSetting"].every(k => k in b.storySettings), "통글 4필드가 항상 있어야 합니다");
        client.assert(["APPROVED", "PENDING", "REJECTED"].includes(b.thumbnailModerationStatus), `표지 검수 상태 actual=${b.thumbnailModerationStatus}`);
        client.assert(b.mainEvents.every((e, i, rows) => i === 0 || rows[i - 1].sortOrder <= e.sortOrder), "주요 사건은 sortOrder 순서");
        client.assert(b.characters.every(c => typeof c.id === "string" && c.images.every(i => typeof i.id === "string" &&
            !("objectKey" in i) && ["APPROVED", "PENDING", "REJECTED"].includes(i.moderationStatus))), "인물·이미지 ID와 검수 상태, objectKey 없음");
    });
%}

