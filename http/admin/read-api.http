### 회원 누적 턴 내림차순 — 기간을 지정해도 누적 기준, 동률은 공개 UUID 오름차순
# 아래 날짜는 fixture의 채팅 생성일에 맞춘다. 메시지 작성일로 기간을 거르지 않는다.
# AI 응답 2·3·4개 방 중 2개 방은 삭제, 4개 방은 이관이고 기간에 2·3개 방만 있으면 누적 9, 기간 턴 5, 기간 채팅 1.
GET {{baseUrl}}/api/v1/admin/members?sort=turnCount&order=desc&chatFrom=2026-10-20&chatTo=2026-10-20&size=100
Authorization: Bearer {{adminToken}}

> {%
    client.test("회원 누적 턴 정렬과 기간 턴", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        const items = response.body.items;
        items.forEach((member, i) => {
            client.assert(Number.isInteger(member.turnCount) && Number.isInteger(member.periodTurnCount) && member.periodTurnCount >= 0 && member.periodTurnCount <= member.turnCount, JSON.stringify(member));
            if (i) {
                const previous = items[i - 1];
                client.assert(previous.turnCount >= member.turnCount, "정렬은 periodTurnCount가 아닌 turnCount 기준이어야 합니다");
                if (previous.turnCount === member.turnCount) client.assert(previous.memberId <= member.memberId, "동률은 공개 UUID 오름차순이어야 합니다");
            }
        });
    });
%}
