### 전체 이프 거래 — 최신순, 같은 시각은 내부 기록 순서의 역순
# 팀 계정 제외를 적용하지 않아 대시보드 카드·추이의 지급/소진 합계와 다를 수 있다.
# memberId 필터는 없다. 한 회원의 거래는 위 회원 거래 내역 API로 조회한다(접속 기록 있음).
# 전체 거래 목록은 접속 기록을 남기지 않으며 balanceAfter·내부 원장 ID·이메일은 반환하지 않는다.
GET {{baseUrl}}/api/v1/admin/credits/transactions?size=20&sort=createdAt&order=desc
Authorization: Bearer {{adminToken}}

> {%
    client.test("전체 거래와 공통 회원 요약", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(Array.isArray(response.body.items) && response.body.page === 1, `actual=${JSON.stringify(response.body)}`);
        client.assert(response.body.items.every(t => !("id" in t) && !("userId" in t) && !("balanceAfter" in t) &&
            t.member.memberId && typeof t.member.isAdmin === "boolean" && t.member.createdAt && !("email" in t.member)), "공개 회원 요약만 반환해야 합니다");
        client.assert(response.body.items.every((t, i, rows) => i === 0 || Date.parse(rows[i - 1].createdAt) >= Date.parse(t.createdAt)), "기록 시각 최신순이어야 합니다");
    });
%}

