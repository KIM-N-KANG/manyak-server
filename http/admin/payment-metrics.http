# 결제 핵심 지표 — ADMIN BACKEND 4-2-43, KNK-1967.
# 준비: 로컬 PostgreSQL·Redis와 ./gradlew bootRun. auth.http의 관리자 로그인으로 adminToken을 저장한 뒤 위에서부터 실행한다.
# 조회 전용이며 결제를 생성하지 않는다. 팀 제외 설정은 대시보드와 같고, 고정 fixture에서 아래 합계 검증을 실행한다.
# 완료 시각이 있는 주문은 환불 상태도 포함한다. 첫 주문은 전체 이력의 completed_at, 동률이면 작은 내부 주문 id로 판정한다.
# 첫 결제 일수는 경과 24시간이 아닌 KST 가입 날짜와 완료 날짜 차이다. 메시지는 USER만 세며 게스트는 제외한다.
@baseUrl = http://localhost:8080
@from = 2026-10-01
@to = 2026-10-20

### 0. 서버 상태
GET {{baseUrl}}/actuator/health

> {%
    client.test("서버 정상", () => client.assert(response.status === 200, `actual=${response.status}`));
%}

### 1. 기본 최근 30일 — 완료 주문/금액/첫 결제/재결제/상품/환불/일수
GET {{baseUrl}}/api/v1/admin/payments/metrics
Authorization: Bearer {{adminToken}}

> {%
    client.test("결제 지표 계약과 합계", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        const b = response.body;
        ["activeMembers", "payingMembers", "orders", "amountKrw", "refundedOrders"].forEach(key =>
            client.assert(Number.isInteger(b[key]) && b[key] >= 0, `field=${key} actual=${b[key]}`));
        const ratios = [["conversionRate", b.payingMembers, b.activeMembers], ["arppu", b.amountKrw, b.payingMembers], ["refundRate", b.refundedOrders, b.orders]];
        ratios.forEach(([key, numerator, denominator]) => client.assert(denominator === 0 ? b[key] === null :
            typeof b[key] === "number" && Math.abs(b[key] - numerator / denominator) < 1e-10, `field=${key} actual=${b[key]}`));
        // 결제 회원에는 메시지를 보내지 않은 회원도 있으므로 conversionRate는 1을 넘을 수 있다.
        client.assert(b.orders === b.firstTime.orders + b.repeat.orders && b.amountKrw === b.firstTime.amountKrw + b.repeat.amountKrw, JSON.stringify(b));
        client.assert(b.products.reduce((sum, p) => sum + p.orders, 0) === b.orders && b.products.reduce((sum, p) => sum + p.amountKrw, 0) === b.amountKrw, JSON.stringify(b.products));
        b.products.forEach((product, i) => {
            client.assert(typeof product.productId === "string" && Number.isInteger(product.creditAmount), JSON.stringify(product));
            if (i) {
                const previous = b.products[i - 1];
                client.assert(previous.amountKrw > product.amountKrw || (previous.amountKrw === product.amountKrw && previous.productId <= product.productId), "상품 순서 오류");
            }
        });
        client.assert(JSON.stringify(b.daysToFirstPayment.map(p => p.bucket)) === JSON.stringify(["0", "1~3", "4~7", "8~30", "31+"]), JSON.stringify(b.daysToFirstPayment));
        client.assert(b.daysToFirstPayment.reduce((sum, p) => sum + p.members, 0) === b.firstTime.orders, JSON.stringify(b.daysToFirstPayment));
        client.assert(typeof b.asOf === "string" && b.from <= b.to, JSON.stringify(b));
        client.global.set("paymentMetricsFrom", b.from);
        client.global.set("paymentMetricsTo", b.to);
    });
%}

### 2. 위에서 받은 기간을 명시 — from/to 요청도 같은 파싱 규칙
GET {{baseUrl}}/api/v1/admin/payments/metrics?from={{paymentMetricsFrom}}&to={{paymentMetricsTo}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("명시 기간", () => client.assert(response.status === 200 && response.body.from === client.global.get("paymentMetricsFrom") && response.body.to === client.global.get("paymentMetricsTo"), JSON.stringify(response.body)));
%}

### 3. 빠른 기간 90일
GET {{baseUrl}}/api/v1/admin/payments/metrics?days=90
Authorization: Bearer {{adminToken}}

> {% client.test("90일 허용", () => client.assert(response.status === 200, `actual=${response.status}`)); %}

### 4. 허용 외 days → 400
GET {{baseUrl}}/api/v1/admin/payments/metrics?days=10
Authorization: Bearer {{adminToken}}

> {% client.test("기간 오류", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 5. 한쪽 날짜만 → 400
GET {{baseUrl}}/api/v1/admin/payments/metrics?from={{from}}
Authorization: Bearer {{adminToken}}

> {% client.test("날짜 쌍 필요", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 6. days와 명시 날짜 혼용 → 400
GET {{baseUrl}}/api/v1/admin/payments/metrics?days=7&from={{from}}&to={{to}}
Authorization: Bearer {{adminToken}}

> {% client.test("기간 혼용 거절", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 7. 미인증 → 401
GET {{baseUrl}}/api/v1/admin/payments/metrics

> {% client.test("관리자 인증 필요", () => client.assert(response.status === 401, `actual=${response.status}`)); %}

### 8. 자유 조회 — 오늘 이하 날짜로 조정
GET {{baseUrl}}/api/v1/admin/payments/metrics?from={{from}}&to={{to}}
Authorization: Bearer {{adminToken}}

# fixture 예: 활성 10명, 그중 2명과 메시지 없는 1명이 결제하면 전환율 0.3.
# 기간 전 환불 완료가 있는 회원의 기간 내 결제는 재결제다. 같은 완료 시각 주문은 먼저 생성된 id 하나만 첫 결제다.
# 기간 내 완료 4건 중 현재 환불 1건이면 orders=4, refundedOrders=1, refundRate=0.25.
# 주문·활성이 없으면 세 비율 null, products=[], 일수 5구간은 모두 0. 팀의 메시지·주문·상품·환불은 전부 제외한다.
