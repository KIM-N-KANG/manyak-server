# 관리자 사용자·전환·품질 지표 수동 검증 (IntelliJ HTTP Client).
# 준비: Postgres·Redis와 ./gradlew bootRun, 관리자 토큰 설정. 실제 Amplitude는 수동 실행 때 호출된다.
# 먼저 health를 확인하고 원하는 카드를 선택 실행한다. 전체 공용 예산은 태스크당 5분 500이다.
# 앞 요청이 예산을 썼다면 다음 카드는 partial/503일 수 있다. 200 전체 검증은 5분 뒤 재실행한다.
# 일별 준비 중 날짜는 pendingDates이며 60초 뒤 같은 요청으로 이어 받는다. 기간은 KST 양끝 포함.
# 신규 가입자·턴 도달·채팅 옵션은 팀 계정 제외, AI 비용은 팀 계정도 포함한다.
# 단가 설정: manyak.admin.ai-prices.models.<모델명>.input-million-krw / output-million-krw.
# 단가가 없으면 해당 costKrw는 null이며 unpricedModels로 확인한다. 단위는 백만 토큰당 KRW다.
@baseUrl = http://localhost:8080
@adminToken = replace-with-admin-token
@rolelessAdminToken = replace-with-admin-token-without-role

### 서버 확인
GET {{baseUrl}}/actuator/health

### 사용자 활동
GET {{baseUrl}}/api/v1/admin/users/activity?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("사용자 활동 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.monthlyActiveUsers === null || Number.isInteger(b.monthlyActiveUsers), "MAU 미수신은 null");
    for (const d of b.daily) client.assert(["all","web","android","unknown"].every(k => Number.isInteger(d.activeUsers[k])) && d.messagesPerUser.all === null && d.messagesPerUser.unknown === null, "플랫폼별 값 구조");
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

### 리텐션
GET {{baseUrl}}/api/v1/admin/users/retention?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("리텐션 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.platforms.map(p => p.platform).join(",") === "all,web,android", "플랫폼 순서");
    for (const p of b.platforms) client.assert(p.cohorts.length + b.pendingDates.length === 7, "코호트 준비 상태");
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

### 평균 세션 길이
GET {{baseUrl}}/api/v1/admin/users/sessions?days=14
Authorization: Bearer {{adminToken}}

> {%
client.test("평균 세션 길이 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    for (const d of b.daily) client.assert(d.averageSessionSeconds.unknown === null && typeof d.averageSessionSeconds.web === "number", "세션 평균 초");
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

### 기능 사용과 안정성
GET {{baseUrl}}/api/v1/admin/quality/client?platform=web&days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("기능 사용과 안정성 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.platform === "web", "적용 플랫폼");
    for (const d of b.daily) client.assert(d.streamErrorRate === null || d.streamErrorRate >= 0, "오류율은 1을 넘을 수 있음");
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

### 신규 가입자 — Amplitude 장애와 무관하게 동작
GET {{baseUrl}}/api/v1/admin/users/signups?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("신규 가입자와 서비스 시작부터 누계", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  client.assert(b.daily.length === 7 && b.daily.every(d => d.signups.total === d.signups.google + d.signups.kakao + d.signups.other), "계약 필드 확인");
  b.daily.forEach((d, i) => {
    client.assert(d.cumulativeSignups >= d.signups.total, `범위 시작 전 가입 포함 actual=${JSON.stringify(d)}`);
    if (i > 0) client.assert(d.cumulativeSignups === b.daily[i - 1].cumulativeSignups + d.signups.total, `일별 누계 actual=${JSON.stringify(d)}`);
  });
  client.global.set("membersSignupLastTotal", b.daily[b.daily.length - 1].cumulativeSignups);
});
%}

### 신규 가입자 요청 직후 요약 비교 — 가입자 데이터가 고정된 로컬 환경에서 순서대로 실행
# days=7은 오늘 포함. 두 요청 사이 가입/팀 제외 설정 변경이 없을 때 마지막 누계와 요약이 같다.
GET {{baseUrl}}/api/v1/admin/dashboard/summary
Authorization: Bearer {{adminToken}}

> {%
client.test("마지막 가입 누계와 요약 일치", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const m = response.body.members;
  client.assert(m.total === m.active + m.withdrawn, `actual=${JSON.stringify(m)}`);
  client.assert(m.total === Number(client.global.get("membersSignupLastTotal")), `요약=${m.total}, 가입 누계=${client.global.get("membersSignupLastTotal")}`);
});
%}

### 턴 도달률 — Amplitude 장애와 무관하게 동작
GET {{baseUrl}}/api/v1/admin/conversion/turn-reach?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("턴 도달률의 열두 기준 턴과 비율", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  const thresholds = [1, 2, 3, 4, 5, 6, 7, 10, 15, 20, 30, 50];
  client.assert(b.segments.map(s => s.segment).join(",") === "all,guest,member", "세 구간 순서");
  b.segments.forEach(s => {
    client.assert(JSON.stringify(s.reached.map(p => p.turn)) === JSON.stringify(thresholds), `기준 턴 actual=${JSON.stringify(s.reached)}`);
    s.reached.forEach(p => client.assert(p.rate === (s.chats === 0 ? 0 : p.chats / s.chats), `도달률 actual=${JSON.stringify(p)}`));
  });
});
%}

### 채팅 옵션 — Amplitude 장애와 무관하게 동작
GET {{baseUrl}}/api/v1/admin/quality/chat-options?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("채팅 옵션과 모델별 턴 수", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  client.assert(b.daily.length === 7 && b.daily.every(d => d.withPersona <= d.chats), "계약 필드 확인");
  b.daily.forEach(d => {
    client.assert(d.turnsByModel !== null && typeof d.turnsByModel === "object" && !Array.isArray(d.turnsByModel), `모델별 턴 actual=${JSON.stringify(d)}`);
    Object.values(d.turnsByModel).forEach(n => client.assert(Number.isInteger(n) && n > 0, `턴 없는 모델은 키 없음 actual=${n}`));
  });
  client.global.set("adminOptionsFrom", b.from);
  client.global.set("adminOptionsTo", b.to);
  client.global.set("adminTurnsByDate", JSON.stringify(Object.fromEntries(b.daily.map(d => [d.date, Object.values(d.turnsByModel).reduce((a, n) => a + n, 0)]))));
});
%}

### 모델별 턴 합과 차트 일별 턴 비교 — 위 채팅 옵션 요청 다음에 실행
# 데이터가 바뀌지 않는 fixture에서 실행한다. 채팅 생성일·삭제 여부 무관, 재생성 판본과 팀 계정은 제외한다.
# 10/21 예시: AURORA 응답 2개(판본 2개), 이전 LITE 채팅 응답 3개, 삭제 LITE 채팅 응답 1개 → AURORA 2, LITE 4.
GET {{baseUrl}}/api/v1/admin/dashboard/charts?from={{adminOptionsFrom}}&to={{adminOptionsTo}}
Authorization: Bearer {{adminToken}}

> {%
client.test("모델별 턴 합과 일별 턴 일치", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const totals = JSON.parse(client.global.get("adminTurnsByDate"));
  response.body.daily.forEach(d => client.assert(d.turns === totals[d.date], `date=${d.date} chart=${d.turns} models=${totals[d.date]}`));
});
%}

### AI 비용 — Amplitude 장애와 무관하게 동작
GET {{baseUrl}}/api/v1/admin/quality/ai-cost?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("AI 비용과 이미지 장당 원가", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  client.assert(b.currency === "KRW" && Array.isArray(b.unpricedModels) && b.totals.costKrw >= 0, "계약 필드 확인");
  client.assert(typeof b.chatImageUnitCostKrw === "number" && b.chatImageUnitCostKrw >= 0, `이미지 장당 설정 원가=${b.chatImageUnitCostKrw}`);
  b.daily.flatMap(d => d.byFeature).filter(f => f.feature === "chat_image").forEach(f => {
    client.assert(f.costKrw === f.calls * b.chatImageUnitCostKrw, `이미지 성공 수 × 장당 원가 actual=${JSON.stringify(f)}`);
    client.assert(f.inputTokens === 0 && f.outputTokens === 0 && f.callsWithoutTokens === 0, "이미지는 토큰 지표에서 제외");
  });
});
%}
# 이미지 성공 수는 총원가에만 포함하고 턴당·스토리당 원가의 분자·분모에서는 제외한다.
# 기본 단가 48원, 이미지 성공 3·실패 1과 본문 원가 3원 fixture: 이미지 144원 / totals 147원 / 턴당 3원.


