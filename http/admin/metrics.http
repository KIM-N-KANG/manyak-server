### 세션 길이 분포 · 날짜마다 전체, Web, Android 3회, 하루 36(all), 평균 세션 길이와 저장과 쿨다운이 따로
# 배포 뒤 확정일 하루의 구간별 세션 수를 같은 조건(국내, 회원은 user_id 있음 세그먼트)의 Amplitude 세션 길이 차트와 대조한다.
GET {{baseUrl}}/api/v1/admin/users/session-lengths?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("세션 길이 분포 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(b.segment === "all" && Array.isArray(b.pendingDates), "적용 segment와 준비 중 날짜");
    client.assert(b.bins.length === 9 && b.bins[0].fromSeconds === 0 && b.bins[8].toSeconds === 86400, `구간 actual=${JSON.stringify(b.bins)}`);
    client.assert(b.platforms.map(p => p.platform).join(",") === "all,web,android", "플랫폼 순서");
    client.assert(b.daily.length + b.pendingDates.length === 7, "일별 세션 준비 상태");
    for (const p of b.platforms) {
      client.assert(b.daily.reduce((sum, d) => sum + d.sessions[p.platform], 0) === p.totalSessions, "일별 합과 구간 전체 합 일치");
      client.assert(p.sessions.length === 9 && p.sessions.reduce((a, c) => a + c, 0) === p.totalSessions, `합 actual=${JSON.stringify(p)}`);
      client.assert(p.totalSessions === 0 ? p.medianBin === null : (p.medianBin >= 0 && p.medianBin < 9), `중앙값 구간 actual=${p.medianBin}`);
    }
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

