### 자유 조회 · 스토리 공개 UUID로 한정 (원하는 UUID로 교체)
GET {{baseUrl}}/api/v1/admin/conversion/funnels/story-detail-chat?platform=android&storyId=cca6358a-0ef3-4709-88d1-100b9faeeca8&days=7
Authorization: Bearer {{adminToken}}


# 퍼널 확정: to가 오늘·어제면 10분, 그 이전이고 전환 창이 남으면 하루 한 번 갱신한다.
# to + 전환 창(1일, 웹→앱은 30일)이 끝난 뒤 받은 값만 확정한다.
# 가입은 ce:신규 가입 (구글·카카오), 게스트 한도 로그인은 ce:로그인 성공 (구글·카카오) 한 조회다.

### 신규 사용자 활성화 · 마지막 단계 turn_number >= 5
GET {{baseUrl}}/api/v1/admin/conversion/funnels/first-visit-activation?days=7&platform=android
Authorization: Bearer {{adminToken}}

> {%
client.test("신규 사용자 활성화", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  if (response.status === 200) {
    const b = response.body;
    client.assert(b.platform === "android" && b.steps.length === 3, "앱 3단계");
    client.assert(b.steps[2].minTurnNumber === 5 && b.steps[2].turnNumber === null, "5턴 이상 하한");
    client.assert(b.steps.every(s => s.platform === null), "공통 플랫폼은 응답 상단에 표시");
  }
});
%}

### 로그인 화면 가입 · 가입 단계는 국내 조건만
GET {{baseUrl}}/api/v1/admin/conversion/funnels/login-signup?days=7
Authorization: Bearer {{adminToken}}

> {% client.test("로그인 화면 가입", () => { client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`); if (response.status === 200) client.assert(response.body.steps.length === 2 && response.body.steps[1].event === "signup_succeeded", "가입 커스텀 이벤트 단계"); }); %}

### 앱 신규 활성화 · 플랫폼 고정
GET {{baseUrl}}/api/v1/admin/conversion/funnels/android-activation?days=7
Authorization: Bearer {{adminToken}}

> {% client.test("앱 신규 활성화", () => { client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`); if (response.status === 200) client.assert(response.body.platform === "android" && response.body.steps.map(s => s.event).join(",") === "_active,signup_succeeded,core_activity", "앱 3단계"); }); %}

### 웹 이용 후 앱 이용 · 30일 창, 플랫폼은 단계마다 표시
GET {{baseUrl}}/api/v1/admin/conversion/funnels/web-to-android?days=7
Authorization: Bearer {{adminToken}}

> {% client.test("웹 이용 후 앱 이용", () => { client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`); if (response.status === 200) client.assert(response.body.platform === null && response.body.steps.map(s => s.platform).join(",") === "web,android", "단계별 플랫폼"); }); %}

