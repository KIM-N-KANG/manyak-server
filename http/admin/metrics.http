# 운영 Amplitude 장애 진단: admin_analytics_fetch_failed의 status·metric·exception·error_code·phase 확인.
# reason=parse_error/status=200/phase=response_decode 또는 result_decode는 응답 형식 오류다.
# reason=http_error/status=null/phase=request는 응답 전 실패이며 HTTP 오류 상태도 http_error다.
# 본문·API 키·Authorization·원문 예외 메시지는 기록하지 않는다.
# 세션 xValues의 ISO 날짜시각과 리텐션의 연도 포함 코호트 라벨을 지원한다.
# MAU는 _active의 Android 외·앱 국내·앱 해외 로그인 3회를 to-29일~to로 조회해 seriesCollapsed를 더한다.
# 활동 all은 Android 외+앱 국내+앱 해외 로그인, android는 앱 두 조회의 합. 신규·평균·세션·리텐션·퍼널은 국내만.
# 리텐션 all은 플랫폼 제한 없는 국내 조회 하나다. 동일 사용자의 플랫폼 전환 복귀를 포함한다.
# 합은 조건별 고유 사용자 수의 합이라 같은 사람이 같은 날/30일 안에 조건을 넘나들면 중복으로 센다.
# 합 구성 조회 하나라도 값이 없으면 해당 날짜는 pendingDates/503, 일부 MAU 구성만 있으면 monthlyActiveUsers=null.
# monthlyActiveUsers는 seriesCollapsed의 범위 고유 사용자이며 일별 값의 합이 아니다.

# 관리자 사용자·전환·품질 지표 수동 검증 (IntelliJ HTTP Client).
# 준비: Postgres·Redis와 ./gradlew bootRun, 관리자 토큰 설정. 실제 Amplitude는 수동 실행 때 호출된다.
# 먼저 health를 확인하고 원하는 카드를 선택 실행한다. 전체 공용 예산은 태스크당 5분 500이다.
# 앞 요청이 예산을 썼다면 다음 카드는 partial/503일 수 있다. 200 전체 검증은 5분 뒤 재실행한다.
# 일별 준비 중 날짜는 pendingDates이며 60초 뒤 같은 요청으로 이어 받는다. 기간은 KST 양끝 포함.
# 신규 가입자·턴 도달·채팅 옵션은 팀 계정 제외, AI 비용은 팀 계정도 포함한다.
# AI 비용: MANYAK_ADMIN_LANGFUSE_HOST/PUBLIC_KEY/SECRET_KEY/ENVIRONMENT 네 값을 서버에 주입한다.
# 개발 기본값은 비어 있으므로 AI 비용만 503이다. 키는 이 파일에 적지 않는다.
# 모델 단가는 Langfuse 모델 설정에서 관리한다. 환율·장당 원가·추적 매핑은 manyak.admin.ai-cost다.
# unpricedModels는 Langfuse 사용량이 있으나 범위 비용 합이 0인 모델이다. 단가 누락·정상 0원·일부 비용 누락은 구별하지 않는다.
@baseUrl = http://localhost:8080
@adminToken = replace-with-admin-token
@rolelessAdminToken = replace-with-admin-token-without-role

### 서버 확인
GET {{baseUrl}}/actuator/health

### 사용자 활동
GET {{baseUrl}}/api/v1/admin/users/activity?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("사용자 활동 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.monthlyActiveUsers === null || Number.isInteger(b.monthlyActiveUsers), "MAU 미수신은 null");
    for (const d of b.daily) client.assert(["all","web","android","unknown"].every(k => Number.isInteger(d.activeUsers[k])) && d.messagesPerUser.all === null && d.messagesPerUser.unknown === null, "플랫폼별 값 구조");
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

### 리텐션 — D1부터 D7까지와 D30, 날짜별 분모로 가중한 요약
# Amplitude 배열: 0=코호트 전체 인원(users), 1=Day 0, n+1=Day n. d1은 Day 1(인덱스 2)이다.
# 배포 뒤 all을 같은 조건(New User→Any Active, N-Day, 국내, Asia/Seoul)의 원본 차트와 대조한다.
# 코호트 users와 Day 1을 비교한다. 저장 원본은 유지되므로 과거 코호트도 즉시 새 인덱스로 읽는다.
# 배포 다음 날 backfill done 뒤, 서비스 시작일 이후 users_retention 확정 행은 32칸 이상이며
# 인덱스 0~31에 incomplete가 없어야 한다. 잘못 확정된 행은 읽을 때 확정을 풀고 하루 한 번 재수집한다.
GET {{baseUrl}}/api/v1/admin/users/retention?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("리텐션 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.platforms.map(p => p.platform).join(",") === "all,web,android", "플랫폼 순서");
    const days = ["d1", "d2", "d3", "d4", "d5", "d6", "d7", "d30"];
    for (const p of b.platforms) {
      client.assert(p.cohorts.length + b.pendingDates.length === 7, "코호트 준비 상태");
      for (const rates of [p.summary, ...p.cohorts]) {
        for (const day of days) client.assert(day in rates && (rates[day] === null ||
          (typeof rates[day] === "number" && rates[day] >= 0 && rates[day] <= 1)),
          `${p.platform}.${day}: expected=null or 0~1 actual=${JSON.stringify(rates)}`);
      }
    }
    // 관찰 날짜가 끝나지 않았거나 값 없음·집계 중·분모 0이면 null이다.
    // 요약은 해당 날짜 지표를 계산할 수 있는 코호트의 분모로 가중하며 단순 평균이 아니다.
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

### 평균 세션 길이
GET {{baseUrl}}/api/v1/admin/users/sessions?days=14
Authorization: Bearer {{adminToken}}

> {%
client.test("평균 세션 길이 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    for (const d of b.daily) client.assert(d.averageSessionSeconds.unknown === null && typeof d.averageSessionSeconds.web === "number", "세션 평균 초");
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

# 기능 사용: web=12회, android=국내+해외 로그인 24회, all=Android 외+앱 둘 36회. 일별 비용도 12/24/36.
### 기능 사용과 안정성
GET {{baseUrl}}/api/v1/admin/quality/client?platform=web&days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("기능 사용과 안정성 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.platform === "web", "적용 플랫폼");
    for (const d of b.daily) client.assert(d.streamErrorRate === null || d.streamErrorRate >= 0, "오류율은 1을 넘을 수 있음");
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

### 신규 가입자 — Amplitude 장애와 무관하게 동작
GET {{baseUrl}}/api/v1/admin/users/signups?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("신규 가입자와 서비스 시작부터 누계", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  client.assert(b.daily.length === 7 && b.daily.every(d => d.signups.total === d.signups.google + d.signups.kakao + d.signups.other), "계약 필드 확인");
  b.daily.forEach((d, i) => {
    client.assert(d.cumulativeSignups >= d.signups.total, `범위 시작 전 가입 포함 actual=${JSON.stringify(d)}`);
    if (i > 0) client.assert(d.cumulativeSignups === b.daily[i - 1].cumulativeSignups + d.signups.total, `일별 누계 actual=${JSON.stringify(d)}`);
  });
  client.global.set("membersSignupLastTotal", b.daily[b.daily.length - 1].cumulativeSignups);
});
%}

### 신규 가입자 요청 직후 요약 비교 — 가입자 데이터가 고정된 로컬 환경에서 순서대로 실행
# days=7은 오늘 포함. 두 요청 사이 가입/팀 제외 설정 변경이 없을 때 마지막 누계와 요약이 같다.
GET {{baseUrl}}/api/v1/admin/dashboard/summary
Authorization: Bearer {{adminToken}}

> {%
client.test("마지막 가입 누계와 요약 일치", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const m = response.body.members;
  client.assert(m.total === m.active + m.withdrawn, `actual=${JSON.stringify(m)}`);
  client.assert(m.total === Number(client.global.get("membersSignupLastTotal")), `요약=${m.total}, 가입 누계=${client.global.get("membersSignupLastTotal")}`);
});
%}

### 턴 도달률 — Amplitude 장애와 무관하게 동작
GET {{baseUrl}}/api/v1/admin/conversion/turn-reach?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("턴 도달률의 열두 기준 턴과 비율", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  const thresholds = [1, 2, 3, 4, 5, 6, 7, 10, 15, 20, 30, 50];
  client.assert(b.segments.map(s => s.segment).join(",") === "all,guest,member", "세 구간 순서");
  b.segments.forEach(s => {
    client.assert(JSON.stringify(s.reached.map(p => p.turn)) === JSON.stringify(thresholds), `기준 턴 actual=${JSON.stringify(s.reached)}`);
    s.reached.forEach(p => client.assert(p.rate === (s.chats === 0 ? 0 : p.chats / s.chats), `도달률 actual=${JSON.stringify(p)}`));
  });
});
%}

### 채팅 옵션 — Amplitude 장애와 무관하게 동작
# byModel은 채팅의 현재 선택 모델, turnsByModel은 메시지에 기록된 청구 모델이다.
# 게스트 응답은 LITE, 기록 전(NULL) 응답은 UNRECORDED. 턴이 없는 키는 생략한다.
GET {{baseUrl}}/api/v1/admin/quality/chat-options?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("채팅 옵션과 모델별 턴 수", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  client.assert(b.daily.length === 7 && b.daily.every(d => d.withPersona <= d.chats), "계약 필드 확인");
  b.daily.forEach(d => {
    client.assert(d.turnsByModel !== null && typeof d.turnsByModel === "object" && !Array.isArray(d.turnsByModel), `모델별 턴 actual=${JSON.stringify(d)}`);
    Object.values(d.turnsByModel).forEach(n => client.assert(Number.isInteger(n) && n > 0, `턴 없는 모델은 키 없음 actual=${n}`));
  });
  client.global.set("adminOptionsFrom", b.from);
  client.global.set("adminOptionsTo", b.to);
  client.global.set("adminTurnsByDate", JSON.stringify(Object.fromEntries(b.daily.map(d => [d.date, Object.values(d.turnsByModel).reduce((a, n) => a + n, 0)]))));
});
%}

### 모델별 턴 합과 차트 일별 턴 비교 — 위 채팅 옵션 요청 다음에 실행
# 데이터가 바뀌지 않는 fixture에서 실행한다. 채팅 생성일·삭제 여부 무관, 재생성 판본과 팀 계정은 제외한다.
# 10/21 예시: 메시지 AURORA 2개(판본 2개), 이전 채팅의 LITE 3개, 삭제 채팅의 LITE 1개,
# 선택 모델 AURORA인 게스트의 LITE 1개, NULL 1개, 팀 계정 응답 1개 → AURORA 2, LITE 5, UNRECORDED 1, 합 8.
GET {{baseUrl}}/api/v1/admin/dashboard/charts?from={{adminOptionsFrom}}&to={{adminOptionsTo}}
Authorization: Bearer {{adminToken}}

> {%
client.test("모델별 턴 합과 일별 턴 일치", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const totals = JSON.parse(client.global.get("adminTurnsByDate"));
  response.body.daily.forEach(d => client.assert(d.turns === totals[d.date], `date=${d.date} chart=${d.turns} models=${totals[d.date]}`));
});
%}

### 청구 모델 고정 fixture — 위 10/21 예시만 준비한 격리 DB에서 선택 실행
GET {{baseUrl}}/api/v1/admin/quality/chat-options?from=2026-10-21&to=2026-10-21
Authorization: Bearer {{adminToken}}

> {%
client.test("청구 모델과 기록 전 턴 분리", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const models = response.body.daily[0].turnsByModel;
  client.assert(models.AURORA === 2 && models.LITE === 5 && models.UNRECORDED === 1 && Object.keys(models).length === 3,
    `expected={AURORA:2,LITE:5,UNRECORDED:1}, actual=${JSON.stringify(models)}`);
  client.global.set("adminOptionsFrom", response.body.from);
  client.global.set("adminOptionsTo", response.body.to);
  client.global.set("adminTurnsByDate", JSON.stringify({"2026-10-21": 8}));
});
%}
# 바로 위의 대시보드 비교 요청을 다시 실행하면 합 8을 검증한다.
# 모델 변경 검증: http/chat/chat-models.http의 회원 턴 시나리오를 실행한다.
# LITE 3턴 뒤 모델만 AURORA로 바꾸면 byModel만 변경되고 turnsByModel의 LITE 3은 유지된다.
# 마지막 턴을 AURORA로 재생성하면 같은 메시지 생성일의 LITE 1이 AURORA 1로 이동하며 합은 유지된다.

### AI 비용 — Langfuse 금액과 DB 호출·토큰 수, Amplitude 예산과 독립
GET {{baseUrl}}/api/v1/admin/quality/ai-cost?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("AI 비용과 이미지 장당 원가", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  client.assert(b.currency === "KRW" && Array.isArray(b.unpricedModels) && b.totals.costKrw >= 0, "계약 필드 확인");
  client.assert(typeof b.usdKrwRate === "number" && b.usdKrwRate > 0, `환율 actual=${b.usdKrwRate}`);
  client.assert(Array.isArray(b.pendingDates) && Array.isArray(b.expiredDates) && Array.isArray(b.unmapped), "Langfuse 준비 중·보관 기간 밖·미매핑 필드");
  client.assert(Number.isInteger(b.retentionDays) && b.retentionDays >= 2 && /^\d{4}-\d{2}-\d{2}$/.test(b.retentionStartDate), "보관 설정과 KST 시작일");
  client.assert(b.pendingDates.every(d => d >= b.retentionStartDate) && b.expiredDates.every(d => d < b.retentionStartDate), "준비 중과 만료 날짜의 경계");
  client.assert(b.daily.length === 7, `빈 날짜도 포함 expected=7 actual=${b.daily.length}`);
  client.assert(JSON.stringify(b.pendingDates) === JSON.stringify([...b.pendingDates].sort()), "준비 중 날짜 오름차순");
  b.daily.filter(d => b.pendingDates.includes(d.date) || b.expiredDates.includes(d.date)).forEach(d => {
    client.assert(d.byFeature.filter(f => f.feature !== "chat_image").every(f => f.costKrw === null), "준비 중·보관 기간 밖 날짜의 Langfuse 금액은 null");
  });
  const total = b.daily.flatMap(d => d.byFeature).reduce((sum, f) => sum + (f.costKrw ?? 0), 0)
    + b.unmapped.reduce((sum, item) => sum + item.costKrw, 0);
  client.assert(Math.abs(total - b.totals.costKrw) < 0.000001, `미매핑 포함 총원가 expected=${total} actual=${b.totals.costKrw}`);
  client.assert(typeof b.chatImageUnitCostKrw === "number" && b.chatImageUnitCostKrw >= 0, `이미지 장당 설정 원가=${b.chatImageUnitCostKrw}`);
  b.daily.flatMap(d => d.byFeature).filter(f => f.feature === "chat_image").forEach(f => {
    client.assert(f.costKrw === f.calls * b.chatImageUnitCostKrw, `이미지 성공 수 × 장당 원가 actual=${JSON.stringify(f)}`);
    client.assert(f.inputTokens === 0 && f.outputTokens === 0 && f.callsWithoutTokens === 0, "이미지는 토큰 지표에서 제외");
  });
});
%}
# 이미지 성공 수는 총원가에만 포함하고 턴당·스토리당 원가의 분자·분모에서는 제외한다.
# 기본 단가 48원, 이미지 성공 3·실패 1과 Langfuse 본문 0.004 USD(환율 1400) fixture:
# 이미지 144원 / 본문 5.6원 / totals 149.6원. 스토리 컴파일 표지·인물 이미지는 Langfuse 비용에 포함.
# 날짜별 저장 값이 없으면 최근부터 3일씩 최대 6번 받는다. 기본 보관 일수 30, 고정 KST 2026-10-24의 빈 90일은 최근 18일·pendingDates 11일·expiredDates 61일이다.
# v2 /api/public/v2/metrics?query=<URL 인코딩 JSON>, config.row_limit=1000. 1000행이면 저장하지 않고 반으로 분할한다.
# 분할 호출도 6번에 포함하며 최소 1시간도 1000행이면 parse_error다. pendingDates가 남으면 같은 범위를 재요청한다.
# KST 종료일 다음 날 00:00의 1ms 전까지 조회한다. 자정 관측과 자정 넘는 추적의 관측은 새 날짜에 한 번만 더한다.
# 정상 조회의 빈 날짜는 value=[]로 저장한다. 저장은 USD, params에는 공개 키를 넣지 않는다.
# 금액에는 실패 관측 비용도 포함한다. 호출 수·토큰 수·원가 분모는 성공한 DB 기록만 센다.
# 확정일은 고정, 어제는 1시간, 오늘은 10분. 실패 시 요청 범위 전체의 저장값을 재사용하며 저장값이 전혀 없을 때 503. 보관 기간 밖만이면 호출 없이 200.

# 보관 시작일 = KST 오늘 − (retentionDays − 2). MANYAK_ADMIN_LANGFUSE_RETENTION_DAYS 기본 30.
# 보관 시작일 전 저장값은 확정 여부와 무관하게 재사용하며, 없는 날짜만 expiredDates로 남는다.
# 5분 배치는 03:00 전에도 확정일(오늘−2)까지 수집한다. 기본 27일은 18일+9일 두 실행, 이후 평소 하루 1회.
# Amplitude 단계 뒤에 작업 없음·예산 소진·429와 무관하게 실행하고, Langfuse만 화면과 직렬화·간격·429·쿨다운(400 포함)을 공유한다.
# 배포 검증: retentionStartDate~오늘−2의 metric=langfuse_ai_cost 행과 finalized_at이 모두 존재하는지 확인한다.
# 화면 요청과 배치 각각 6회 상한, 3일 구간·1초 간격. Amplitude 비용 예산을 사용하지 않는다.

### AI 비용 긴 범위 — 보관 기간 안의 준비 중 날짜만 다음 요청에서 채움
GET {{baseUrl}}/api/v1/admin/quality/ai-cost?from=2026-07-26&to=2026-10-23
Authorization: Bearer {{adminToken}}

> {% client.test("긴 범위 비용", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  client.assert(response.body.daily.length === 90 && Array.isArray(response.body.pendingDates), "90일과 준비 중 날짜");
}); %}

### AI 비용 보관 기간 밖만 — 설정 없어도 200, 저장값 없는 옛 기간에서 호출·실패 로그 없음
GET {{baseUrl}}/api/v1/admin/quality/ai-cost?from=2026-07-01&to=2026-07-31
Authorization: Bearer {{adminToken}}

> {% client.test("과거 미저장 날짜는 오류가 아닌 보관 기간 밖", () => {
  client.assert(response.status === 200, `expected=200 actual=${response.status}`);
  const b = response.body;
  client.assert(b.pendingDates.length === 0, "보관 밖 날짜는 pending이 아님");
  if (b.expiredDates.length === 31) {
    client.assert(b.asOf === null, "Langfuse 저장값 없음이면 asOf=null");
    client.assert(b.totals.costPerTurnKrw === null && b.totals.costPerStoryKrw === null, "원가 분모에서 만료 날짜 제외");
    const images = b.daily.flatMap(d => d.byFeature).filter(f => f.feature === "chat_image").reduce((a,f) => a + f.costKrw, 0);
    client.assert(b.totals.costKrw === images, `이미지 비용만 합산 actual=${b.totals.costKrw}`);
  }
}); %}

### AI 비용 503 — 네 설정 중 하나가 비어 있는 개발 서버 또는 저장값 없이 외부 장애인 서버에서 실행
GET {{baseUrl}}/api/v1/admin/quality/ai-cost?days=7
Authorization: Bearer {{adminToken}}

> {% client.test("Langfuse 사용 불가", () => {
  client.assert(response.status === 503 && response.body.code === "SERVICE_UNAVAILABLE", `actual=${response.status}`);
}); %}

### AI 비용 기간 오류 400
GET {{baseUrl}}/api/v1/admin/quality/ai-cost?days=367
Authorization: Bearer {{adminToken}}

> {% client.test("AI 비용 기간 상한", () => { client.assert(response.status === 400, `actual=${response.status}`); }); %}


