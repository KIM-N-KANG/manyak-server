GET {{baseUrl}}/api/v1/admin/users/sessions?days=14
Authorization: Bearer {{adminToken}}

> {%
client.test("평균 세션 길이 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.daily.length + b.pendingDates.length === 14, "준비된 날짜와 준비 중 날짜 합");
    for (const d of b.daily) {
      for (const field of ["averageSessionSeconds", "sessionsPerUser"]) client.assert(d[field].unknown === null && ["all", "web", "android"].every(k => typeof d[field][k] === "number"), `${field} 플랫폼 구조`);
    }
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

# 기능 사용: web, android, all 각각 15회. all은 전체 조건 하나를 조회한다.
# 간편 제작 오류 사용자 수(storyCompleteError)는 빠지고 서버 DB storyCompletion(범위의 모든 날짜, platform·segment 무관)이 붙는다.
# 운영 대조: 날짜마다 requests와 failed가 story_creation_requests(stage STORY_COMPLETION, 팀 계정 제외) 집계와 같다.
### 기능 사용과 안정성
GET {{baseUrl}}/api/v1/admin/quality/client?platform=web&days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("기능 사용과 안정성 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.platform === "web", "적용 플랫폼");
    for (const d of b.daily) client.assert(d.streamErrorRate === null || d.streamErrorRate >= 0, "오류율은 1을 넘을 수 있음");
    for (const d of b.daily) {
      client.assert(!("storyCompleteError" in d.users), "간편 제작 오류 사용자 수 제거");
      const a = d.activity;
      client.assert(["aiResponses", "simpleCompletions", "generalSubmissions", "coreActiveUsers"].every(k => Number.isInteger(a[k]) && a[k] >= 0), "활동량 정수");
      const messages = Object.values(d.messagesByInputMode).reduce((sum, n) => sum + n, 0);
      client.assert(a.messagesPerCoreUser === (a.coreActiveUsers === 0 ? null : messages / a.coreActiveUsers), "핵심 활동 사용자당 메시지");
      client.assert(a.simpleCompletionsPerCoreUser === (a.coreActiveUsers === 0 ? null : a.simpleCompletions / a.coreActiveUsers), "핵심 활동 사용자당 간편 제작 완료");
    }
    client.assert(b.storyCompletion.length === 7, `실패율은 범위의 모든 날짜 actual=${b.storyCompletion.length}`);
    for (const c of b.storyCompletion) client.assert(c.failed <= c.requests && (c.requests === 0 ? c.failureRate === null : c.failureRate === c.failed / c.requests), `실패율 actual=${JSON.stringify(c)}`);
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

