### 신규 가입자 · Amplitude 장애와 무관하게 동작
GET {{baseUrl}}/api/v1/admin/users/signups?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("신규 가입자와 서비스 시작부터 누계", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  // 연동 행이 없는 재가입 예전 계정은 빠지므로 total은 google과 kakao의 합이고 other는 없다.
  client.assert(b.daily.length === 7 && b.daily.every(d => d.signups.total === d.signups.google + d.signups.kakao && !("other" in d.signups)), "계약 필드 확인");
  client.assert(Array.isArray(b.pendingDates) && b.daily.every(d => b.pendingDates.includes(d.date) === (d.signupsByPlatform === null)), "준비 중 날짜만 플랫폼 null");
  for (const d of b.daily) {
    const pending = b.pendingDates.includes(d.date);
    ["signupsByPlatform", "newVisitorsByPlatform", "signupRate"].forEach(k => client.assert((d[k] === null) === pending, `${k} 공동 준비 상태`));
    if (!pending) for (const platform of ["all", "web", "android"]) client.assert(d.signupRate[platform] === (d.newVisitorsByPlatform[platform] === 0 ? null : d.signupsByPlatform[platform] / d.newVisitorsByPlatform[platform]), "가입 전환율, 1 초과 허용");
  }
  b.daily.filter(d => d.signupsByPlatform).forEach(d => {
    const p = d.signupsByPlatform;
    client.assert(!("unknown" in p) && ["all", "web", "android"].every(k => Number.isInteger(p[k])), `플랫폼 합 actual=${JSON.stringify(p)}`);
  });
  b.daily.forEach((d, i) => {
    client.assert(d.cumulativeSignups >= d.signups.total, `범위 시작 전 가입 포함 actual=${JSON.stringify(d)}`);
    if (i > 0) client.assert(d.cumulativeSignups === b.daily[i - 1].cumulativeSignups + d.signups.total, `일별 누계 actual=${JSON.stringify(d)}`);
  });
  client.global.set("membersSignupLastTotal", b.daily[b.daily.length - 1].cumulativeSignups);
});
%}

### 신규 가입자 요청 직후 요약 비교 · 가입자 데이터가 고정된 로컬 환경에서 순서대로 실행
# days=7은 오늘 포함. 누계는 연동 행이 없는 재가입 예전 계정을 빼므로 요약 members.total 이하다.
# 두 값의 차이는 SELECT COUNT(*) FROM users u WHERE NOT EXISTS (SELECT 1 FROM social_accounts a WHERE a.user_id=u.id) (팀 계정 제외)와 같다.
GET {{baseUrl}}/api/v1/admin/dashboard/summary
Authorization: Bearer {{adminToken}}

> {%
client.test("마지막 가입 누계와 요약 일치", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const m = response.body.members;
  client.assert(m.total === m.active + m.withdrawn, `actual=${JSON.stringify(m)}`);
  client.assert(m.total >= Number(client.global.get("membersSignupLastTotal")), `요약=${m.total}, 가입 누계=${client.global.get("membersSignupLastTotal")}`);
});
%}

### 턴 도달률 · Amplitude 장애와 무관하게 동작
GET {{baseUrl}}/api/v1/admin/conversion/turn-reach?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("턴 도달률의 열두 기준 턴과 비율", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const b = response.body;
  const thresholds = [1, 2, 3, 4, 5, 6, 7, 10, 15, 20, 30, 50];
  client.assert(b.segments.map(s => s.segment).join(",") === "all,guest,member", "세 구간 순서");
  b.segments.forEach(s => {
    client.assert(JSON.stringify(s.reached.map(p => p.turn)) === JSON.stringify(thresholds), `기준 턴 actual=${JSON.stringify(s.reached)}`);
    s.reached.forEach(p => client.assert(p.rate === (s.chats === 0 ? 0 : p.chats / s.chats), `도달률 actual=${JSON.stringify(p)}`));
  });
  client.assert(b.segment === "all" && Array.isArray(b.pendingDates), `segment 기본값 actual=${b.segment}`);
  // 플랫폼 도달은 턴 저장일 기준 성공 이벤트 수이고 분모가 1턴 수라 1을 넘을 수 있다. 준비된 날짜가 없으면 null.
  if (b.platforms !== null) {
    client.assert(b.platforms.map(p => p.platform).join(",") === "all,web,android", "세 플랫폼 순서");
    b.platforms.forEach(p => {
      client.assert(p.chats === p.reached[0].chats && JSON.stringify(p.reached.map(r => r.turn)) === JSON.stringify(thresholds), `플랫폼 기준 턴 actual=${JSON.stringify(p)}`);
      p.reached.forEach(r => client.assert(r.rate === (p.chats === 0 ? 0 : r.chats / p.chats), `플랫폼 도달률 actual=${JSON.stringify(r)}`));
    });
    const sum = ["web", "android"].reduce((a, k) => a + b.platforms.find(p => p.platform === k).chats, 0);
    client.assert(b.platforms[0].chats === sum, `전체는 웹과 앱 합 actual=${b.platforms[0].chats}/${sum}`);
  }
  client.global.set("turnReachSegments", JSON.stringify(b.segments));
});
%}

### 턴 도달률 회원만 · 위 요청 다음에 실행. segment는 platforms만 거르고 DB segments는 그대로다.
# 게스트는 이벤트에 user_id가 없는 턴, 회원은 있는 턴(턴을 만든 때의 로그인 상태). 기본 범위 30일 첫 조회는 하루 24라 여러 5분에 걸쳐 채워진다.
