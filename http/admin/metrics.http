# 운영 Amplitude 장애 진단: admin_analytics_fetch_failed의 status·metric·exception·error_code·phase 확인.
# reason=parse_error/status=200/phase=response_decode 또는 result_decode는 응답 형식 오류다.
# reason=http_error/status=null/phase=request는 응답 전 실패이며 HTTP 오류 상태도 http_error다.
# 본문·API 키·Authorization·원문 예외 메시지는 기록하지 않는다.
# 세션 xValues의 ISO 날짜시각과 리텐션의 연도 포함 코호트 라벨을 지원한다.
# MAU는 국내 조건과 platform is ["Web","Android"]의 _active 한 조회에서 seriesCollapsed를 쓴다.
# 활동 all은 웹이나 앱 사용자 한 번이며 unknown은 별도로 유지하고 전체에 넣지 않는다.
# 리텐션은 시작과 복귀 양쪽에 플랫폼 조건을 건다. all은 웹에서 앱으로 복귀한 사용자도 포함한다.
# 세션 all과 기능 사용 all도 전체 조건 조회 하나의 값이다. 해외 로그인 앱 회원은 더하지 않는다.
# 합 구성 조회 하나라도 값이 없으면 해당 날짜는 pendingDates/503이고 MAU 미수신은 null이다.
# monthlyActiveUsers는 seriesCollapsed의 범위 고유 사용자이며 일별 값의 합이 아니다.

# 관리자 사용자·전환·품질 지표 수동 검증 (IntelliJ HTTP Client).
# 준비: Postgres·Redis와 ./gradlew bootRun, 관리자 토큰 설정. 실제 Amplitude는 수동 실행 때 호출된다.
# 먼저 health를 확인하고 원하는 카드를 선택 실행한다. 전체 공용 예산은 태스크당 5분 500이다.
# 앞 요청이 예산을 썼다면 다음 카드는 partial/503일 수 있다. 200 전체 검증은 5분 뒤 재실행한다.
# 일별 준비 중 날짜는 pendingDates이며 60초 뒤 같은 요청으로 이어 받는다. 기간은 KST 양끝 포함.
# 신규 가입자·턴 도달·채팅 옵션은 팀 계정 제외, AI 비용은 팀 계정도 포함한다.
# 세 DB 지표의 플랫폼 값(signupsByPlatform, platforms, chatStarters 등)은 Amplitude라 팀 계정을 포함하고 국내 조건의 all, web, android 세 값이며 unknown은 없다. 가입 all은 전체 조회, 턴 합계 all은 웹과 앱의 합이다.
# 플랫폼 값을 못 받은 날짜는 그 값만 null이고 pendingDates에 든다. DB 값은 Amplitude 장애와 무관하게 200이다.
# 플랫폼 조회는 차례 대기를 포함해 5초 한도라 넘기면 받은 값만 저장하고 DB 값을 바로 준다(그 키 60초 쿨다운).
# AI 비용: MANYAK_ADMIN_LANGFUSE_HOST/PUBLIC_KEY/SECRET_KEY/ENVIRONMENT 네 값을 서버에 주입한다.
# 개발 기본값은 비어 있으므로 AI 비용만 503이다. 키는 이 파일에 적지 않는다.
# 모델 단가는 Langfuse 모델 설정에서 관리한다. 환율·장당 원가·추적 매핑은 manyak.admin.ai-cost다.
# unpricedModels는 Langfuse 사용량이 있으나 범위 비용 합이 0인 모델이다. 단가 누락·정상 0원·일부 비용 누락은 구별하지 않는다.
@baseUrl = http://localhost:8080
@adminToken = replace-with-admin-token
@rolelessAdminToken = replace-with-admin-token-without-role

### 서버 확인
GET {{baseUrl}}/actuator/health

### 사용자 활동
GET {{baseUrl}}/api/v1/admin/users/activity?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("사용자 활동 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.monthlyActiveUsers === null || Number.isInteger(b.monthlyActiveUsers), "MAU 미수신은 null");
    for (const d of b.daily) client.assert(["all","web","android","unknown"].every(k => Number.isInteger(d.activeUsers[k])) && d.messagesPerUser.all === null && d.messagesPerUser.unknown === null, "플랫폼별 값 구조");
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

### 리텐션 · D1부터 D7까지와 D30, 날짜별 분모로 가중한 요약
# Amplitude 배열: 0=코호트 전체 인원(users), 1=Day 0, n+1=Day n. d1은 Day 1(인덱스 2)이다.
# 배포 뒤 all을 같은 조건(New User→Any Active, N-Day, 국내와 platform Web 또는 Android, Asia/Seoul)의 원본 차트와 대조한다.
# 코호트 users와 Day 1을 비교한다. 저장 원본은 유지되므로 과거 코호트도 즉시 새 인덱스로 읽는다.
# 배포 다음 날 backfill done 뒤, 서비스 시작일 이후 users_retention 확정 행은 32칸 이상이며
# 인덱스 0~31에 incomplete가 없어야 한다. 잘못 확정된 행은 읽을 때 확정을 풀고 하루 한 번 재수집한다.
GET {{baseUrl}}/api/v1/admin/users/retention?days=7
Authorization: Bearer {{adminToken}}

> {%
client.test("리텐션 응답", () => {
  client.assert(response.status === 200 || response.status === 503, `actual=${response.status}`);
  const b = response.body;
  if (response.status === 200) {
    client.assert(Array.isArray(b.pendingDates), "준비 중 날짜 구조");
    client.assert(b.platforms.map(p => p.platform).join(",") === "all,web,android", "플랫폼 순서");
    const days = ["d1", "d2", "d3", "d4", "d5", "d6", "d7", "d30"];
    for (const p of b.platforms) {
      client.assert(p.cohorts.length + b.pendingDates.length === 7, "코호트 준비 상태");
      for (const rates of [p.summary, ...p.cohorts]) {
        for (const day of days) client.assert(day in rates && (rates[day] === null ||
          (typeof rates[day] === "number" && rates[day] >= 0 && rates[day] <= 1)),
          `${p.platform}.${day}: expected=null or 0~1 actual=${JSON.stringify(rates)}`);
      }
    }
    // 관찰 날짜가 끝나지 않았거나 값 없음·집계 중·분모 0이면 null이다.
    // 요약은 해당 날짜 지표를 계산할 수 있는 코호트의 분모로 가중하며 단순 평균이 아니다.
    client.assert(b.cohort === "visitor", `cohort 생략은 방문자 actual=${b.cohort}`);
  } else client.assert(b.code === "SERVICE_UNAVAILABLE", "표준 사용 불가");
});
%}

### 리텐션 가입자 · ce:신규 가입 (구글·카카오) 세 플랫폼 3회, 하루 24(7일 168)
# 배포 뒤 all을 가입 커스텀 이벤트 → Any Active, N-Day, 국내와 Web/Android OR 조건의 Amplitude 차트과 대조한다.
