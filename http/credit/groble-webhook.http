Content-Type: application/json
X-Groble-Timestamp: {{grobleTimestamp}}
X-Groble-Signature: {{grobleSignature}}
X-Groble-Idempotency-Key: manual-delivery

{"id":"{{grobleEventId}}","type":"payment.completed","data":{"object":{"sellerReference":"{{grobleOrderId}}","merchantUid":"{{grobleMerchantUid}}","pricing":{"finalAmount":5000}}}}

> {%
    client.test("4. 같은 완료 재전송 — 중복 적립 없음", () => client.assert(response.status === 200, `expected=200 actual=${response.status}`));
%}

### 5. 완료 주문 확인 (3~4번 선행)
GET {{baseUrl}}/api/v1/users/me/credits/orders/{{grobleOrderId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("완료 상태", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(response.body.status === "COMPLETED", `expected=COMPLETED actual=${response.body.status}`);
        client.assert(response.body.completedAt !== null, "completedAt expected");
    });
%}

