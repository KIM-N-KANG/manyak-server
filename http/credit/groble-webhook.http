# KNK-1157 그로블 웹훅 적립·환불 검증 (로컬 전용 합성 이벤트)
# 준비: PostgreSQL·Redis 기동 → MANYAK_GROBLE_WEBHOOK_SECRET 설정 → ./gradlew bootRun.
# application.yml if_5000 상품 payment-url도 채운다. 기존 credit-orders.http 준비 방법 참고.
# IntelliJ HTTP Client 환경 private 파일에 grobleWebhookSecret을 서버와 같은 값으로 설정한다.
# accessToken은 로그인 응답에서 입력한다. 시크릿은 이 파일에 입력하지 않는다.
# 위에서부터 실행. 합성 웹훅은 실제 돈의 이동 없이 로컬 이프를 변경하므로 전용 테스트 회원을 사용한다.
# 503 요청은 마지막에 서버 시크릿을 비우고 재기동한 뒤 따로 실행한다.
@baseUrl = http://localhost:8080
@accessToken = REPLACE_WITH_ACCESS_TOKEN

### 1. 헬스 확인
GET {{baseUrl}}/actuator/health

### 2. 주문 생성 (5000원 → 보너스 포함 5200 이프)
POST {{baseUrl}}/api/v1/users/me/credits/orders
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"productId":"if_5000"}

> {%
    client.test("주문 생성", () => client.assert(response.status === 201, `expected=201 actual=${response.status}`));
    if (response.status === 201) {
        client.global.set("grobleOrderId", response.body.orderId);
        client.global.set("grobleEventId", "manual-complete-" + response.body.orderId);
        client.global.set("grobleMerchantUid", "manual-merchant-" + response.body.orderId);
    }
%}


### 3. 완료 이벤트 — Previous 서명으로 검증
< {%
    const ts = String(Math.floor(Date.now() / 1000));
    request.variables.set("grobleTimestamp", ts);
    const signature = crypto.hmac.sha256()
        .withTextSecret(request.environment.get("grobleWebhookSecret"))
        .updateWithText(ts + "." + request.body.tryGetSubstituted())
        .digest().toHex();
    request.variables.set("grobleSignature", signature);
%}
POST {{baseUrl}}/api/v1/webhooks/groble
Content-Type: application/json
X-Groble-Timestamp: {{grobleTimestamp}}
X-Groble-Signature: 00
X-Groble-Signature-Previous: {{grobleSignature}}
X-Groble-Idempotency-Key: manual-delivery

{"id":"{{grobleEventId}}","type":"payment.completed","data":{"object":{"sellerReference":"{{grobleOrderId}}","merchantUid":"{{grobleMerchantUid}}","pricing":{"finalAmount":5000}}}}

> {%
    client.test("3. 완료 이벤트 — Previous 서명으로 검증", () => client.assert(response.status === 200, `expected=200 actual=${response.status}`));
%}

