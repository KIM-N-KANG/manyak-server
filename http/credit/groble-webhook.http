### 9. 환불 주문 확인
GET {{baseUrl}}/api/v1/users/me/credits/orders/{{grobleOrderId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("환불 상태", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(response.body.status === "REFUNDED", `expected=REFUNDED actual=${response.body.status}`);
    });
%}

### 10. 이용내역 — 전용 회원에서 PURCHASE +5200, PURCHASE_REVERSAL -5200 각 1건
GET {{baseUrl}}/api/v1/users/me/credits/transactions?type=ALL&limit=100
Authorization: Bearer {{accessToken}}

> {%
    client.test("구매·회수 각 1회", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        for (const [reason, type, amount] of [["PURCHASE", "EARN", 5200], ["PURCHASE_REVERSAL", "EXPIRE", -5200]]) {
            const rows = response.body.items.filter(it => it.reason === reason);
            client.assert(rows.length === 1, `expected=1 ${reason} actual=${rows.length}`);
            client.assert(rows[0].type === type && rows[0].amount === amount && rows[0].title === null, JSON.stringify(rows[0]));
        }
    });
%}

