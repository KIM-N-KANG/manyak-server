# 탐색 목록 검증. docker compose up -d 및 ./gradlew bootRun 후 위에서부터 실행합니다.
# 준비 요청은 실제 AI와 이미지 저장소가 설정된 로컬 서버에서 공개 표지가 있는 게스트 스토리 2개를 만듭니다.
# 표지 생성에 실패하면 상세의 표지 검증에서 멈추고 이미지 설정을 확인합니다.
# 회원 소유 제외는 마지막 선택 요청에서 로그인 토큰을 넣어 확인합니다.
@baseUrl = http://localhost:8080
@accessToken = PUT_A_VALID_ACCESS_TOKEN_HERE

### 0. 상태 확인과 이번 실행의 디바이스 준비
GET {{baseUrl}}/actuator/health

> {%
    client.test("서버 상태", () => client.assert(response.status === 200, `expected=200 actual=${response.status}`));
    client.global.set("exploreDeviceA", "explore-a-" + Date.now());
    client.global.set("exploreDeviceB", "explore-b-" + Date.now());
%}

### 1. 간편 제작 장르 준비
GET {{baseUrl}}/api/v1/stories/simple/tags

> {%
    client.test("장르 태그 준비", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        const genre = response.body.find(t => t.category === "GENRE");
        client.assert(Boolean(genre), "GENRE 태그가 필요합니다.");
        client.global.set("exploreGenreId", genre.id);
    });
%}

### 준비 A: 스토리라인 생성
POST {{baseUrl}}/api/v1/stories/simple/storylines
X-Manyak-Device-Id: {{exploreDeviceA}}
Content-Type: application/json

{"requestId":"{{$uuid}}","genreTagIds":[{{exploreGenreId}}],"protagonist":{"name":"아린","gender":"FEMALE","featureTagIds":[],"customTags":[]},"supportingCharacters":[]}

> {%
    client.test("스토리라인 생성", () => client.assert(response.status === 201, `expected=201 actual=${response.status}`));
    client.global.set("exploreCreationA", response.body.simpleCreationId);
    client.global.set("exploreStorylineA", response.body.storylines[0].id);
%}

### 준비 A: 공개 완성
POST {{baseUrl}}/api/v1/stories/simple
X-Manyak-Device-Id: {{exploreDeviceA}}
Content-Type: application/json

{"requestId":"{{$uuid}}","simpleCreationId":{{exploreCreationA}},"storylineId":{{exploreStorylineA}},"visibility":"PUBLIC"}

> {%
    client.test("게스트 공개 완성", () => client.assert(response.status === 201, `expected=201 actual=${response.status}`));
    client.global.set("exploreStoryA", response.body.id);
%}

### 준비 A: 공개 표지 확인
GET {{baseUrl}}/api/v1/stories/{{exploreStoryA}}

> {%
    client.test("공개 표지가 있다", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(Boolean(response.body.thumbnailUrl), `표지가 필요합니다. actual=${response.body.thumbnailUrl}`);
        client.assert(response.body.visibility === "PUBLIC", `expected=PUBLIC actual=${response.body.visibility}`);
    });
%}

### 준비 B: 스토리라인 생성
POST {{baseUrl}}/api/v1/stories/simple/storylines
X-Manyak-Device-Id: {{exploreDeviceB}}
Content-Type: application/json

{"requestId":"{{$uuid}}","genreTagIds":[{{exploreGenreId}}],"protagonist":{"name":"아린","gender":"FEMALE","featureTagIds":[],"customTags":[]},"supportingCharacters":[]}

> {%
    client.test("스토리라인 생성", () => client.assert(response.status === 201, `expected=201 actual=${response.status}`));
    client.global.set("exploreCreationB", response.body.simpleCreationId);
    client.global.set("exploreStorylineB", response.body.storylines[0].id);
%}

### 준비 B: 공개 완성
POST {{baseUrl}}/api/v1/stories/simple
X-Manyak-Device-Id: {{exploreDeviceB}}
Content-Type: application/json

{"requestId":"{{$uuid}}","simpleCreationId":{{exploreCreationB}},"storylineId":{{exploreStorylineB}},"visibility":"PUBLIC"}

> {%
    client.test("게스트 공개 완성", () => client.assert(response.status === 201, `expected=201 actual=${response.status}`));
    client.global.set("exploreStoryB", response.body.id);
%}

### 준비 B: 공개 표지 확인
GET {{baseUrl}}/api/v1/stories/{{exploreStoryB}}

> {%
    client.test("공개 표지가 있다", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(Boolean(response.body.thumbnailUrl), `표지가 필요합니다. actual=${response.body.thumbnailUrl}`);
        client.assert(response.body.visibility === "PUBLIC", `expected=PUBLIC actual=${response.body.visibility}`);
    });
%}

### 2. 익명 탐색 첫 페이지: 위 준비로 최소 2건의 공개 표지가 있어야 합니다
GET {{baseUrl}}/api/v1/stories/explore?limit=1

> {%
    client.test("표지가 있는 탐색 카드와 다음 커서", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(response.body.items.length === 1, `expected=1 actual=${response.body.items.length}`);
        client.assert(Boolean(response.body.items[0].thumbnailUrlSm), "표지 없는 카드가 나왔습니다.");
        client.assert(Boolean(response.body.nextCursor), "공개 표지 스토리 2개 이상이 필요합니다.");
        client.assert(!response.body.nextCursor.includes("="), "패딩 없는 Base64URL 커서여야 합니다.");
    });
    client.global.set("exploreFirstId", response.body.items[0].id);
    client.global.set("exploreCursor", response.body.nextCursor);
%}

### 3. 같은 순서로 다음 페이지: 2번을 먼저 실행합니다
GET {{baseUrl}}/api/v1/stories/explore?limit=1&cursor={{exploreCursor}}

> {%
    client.test("다음 페이지에 중복이 없다", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(response.body.items.length === 1, `expected=1 actual=${response.body.items.length}`);
        client.assert(response.body.items[0].id !== client.global.get("exploreFirstId"), "첫 페이지 카드가 중복됐습니다.");
    });
%}

### 4. 새 순서로 시작: 결과 개수와 공개 표지, 게스트 작성자 확인
# 시드가 새로 만들어지며 작은 목록에서는 우연히 같은 순서가 나올 수도 있습니다.
GET {{baseUrl}}/api/v1/stories/explore?limit=50

> {%
    client.test("표지가 있는 공개 카드만 반환한다", () => {
        client.assert(response.status === 200, `expected=200 actual=${response.status}`);
        client.assert(response.body.items.every(x => x.thumbnailUrlSm && x.status === "PUBLISHED" && x.visibility === "PUBLIC"), JSON.stringify(response.body));
        const guest = response.body.items.find(x => x.id === client.global.get("exploreStoryA"));
        if (guest) client.assert(guest.author === null, `expected=null actual=${JSON.stringify(guest.author)}`);
    });
%}

### 5. 다른 목록의 커서는 400
GET {{baseUrl}}/api/v1/stories/explore?cursor=bDo0MjowMDAwMDAwMC0wMDAwLTAwMDAtMDAwMC0wMDAwMDAwMDAwMDE

> {%
    client.test("다른 접두 커서 거절", () => client.assert(response.status === 400 && response.body.code === "BAD_REQUEST", `expected=400/BAD_REQUEST actual=${response.status}/${response.body.code}`));
%}

### 6. 숫자가 아닌 limit은 400
GET {{baseUrl}}/api/v1/stories/explore?limit=wrong

> {%
    client.test("limit 형식 검증", () => client.assert(response.status === 400 && response.body.code === "BAD_REQUEST", `expected=400/BAD_REQUEST actual=${response.status}/${response.body.code}`));
%}

### 자유 조회: 기존 DB 전체를 새 순서로 확인
GET {{baseUrl}}/api/v1/stories/explore

### 선택 실행: 회원 탐색은 본인 스토리가 제외됩니다
# auth/auth-login-google.http에서 토큰을 준비하고 본인 소유의 공개 표지 스토리가 있는 상태로 확인합니다.
GET {{baseUrl}}/api/v1/stories/explore?limit=50
Authorization: Bearer {{accessToken}}
