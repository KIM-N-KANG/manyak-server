### 3. (핵심 검증) 인증 없이 최신순 첫 페이지 → 200, B가 A보다 앞
GET {{baseUrl}}/api/v1/stories?sort=latest
Accept: application/json

> {%
    client.test("비로그인 조회가 200이다", () => {
        client.assert(response.status === 200, `200이 아닙니다. actual=${response.status}`);
    });
    const items = response.body.items;
    client.test("카드에 non-null isOriginal이 있고 일반 회원 스토리는 false다", () => {
        for (const card of items) {
            client.assert(typeof card.isOriginal === "boolean" && !("original" in card),
                `isOriginal boolean이 필요합니다. actual=${JSON.stringify(card)}`);
            if ([client.global.get("storyIdA"), client.global.get("storyIdB")].includes(card.id)) {
                client.assert(card.isOriginal === false, `일반 회원 스토리는 false여야 합니다. actual=${card.isOriginal}`);
            }
        }
    });
    client.test("응답이 items·nextCursor 계약을 지킨다", () => {
        client.assert(Array.isArray(items), `items가 배열이 아닙니다. actual=${JSON.stringify(response.body)}`);
        client.assert(response.body.nextCursor === null || typeof response.body.nextCursor === "string",
            `nextCursor 형식이 다릅니다. actual=${JSON.stringify(response.body.nextCursor)}`);
    });
    const idxA = items.findIndex(it => it.id === client.global.get("storyIdA"));
    const idxB = items.findIndex(it => it.id === client.global.get("storyIdB"));
    client.test("방금 만든 두 스토리가 최신순(B 먼저)으로 들어 있다", () => {
        client.assert(idxA >= 0 && idxB >= 0, `방금 만든 스토리가 목록에 없습니다. ids=${items.map(it => it.id).join(",")}`);
        client.assert(idxB < idxA, `B가 A보다 앞이어야 합니다. idxB=${idxB}, idxA=${idxA}`);
    });
    client.test("카드에 작성자·좋아요 수·턴 수·장르가 실린다", () => {
        const card = items[idxB];
        client.assert(card.author !== null && typeof card.author.nickname === "string",
            `author가 비었습니다. actual=${JSON.stringify(card.author)}`);
        client.assert(typeof card.likeCount === "number", `likeCount가 숫자가 아닙니다. actual=${card.likeCount}`);
        client.assert(typeof card.turnCount === "number", `turnCount가 숫자가 아닙니다. actual=${card.turnCount}`);
        client.assert(Array.isArray(card.genres), `genres가 배열이 아닙니다. actual=${JSON.stringify(card.genres)}`);
        client.assert(card.status === "PUBLISHED", `status가 PUBLISHED가 아닙니다. actual=${card.status}`);
    });
%}

### 4. (커서) limit=1 로 첫 페이지 → nextCursor 를 전역에 저장
GET {{baseUrl}}/api/v1/stories?sort=latest&limit=1
Accept: application/json

> {%
    client.test("limit=1이면 한 건만 온다", () => {
        client.assert(response.body.items.length === 1, `1건이 아닙니다. actual=${response.body.items.length}`);
    });
    client.test("다음 페이지가 있으면 nextCursor가 실린다", () => {
        client.assert(typeof response.body.nextCursor === "string" && response.body.nextCursor.length > 0,
            `nextCursor가 없습니다(공개 스토리가 1건뿐이면 정상). actual=${JSON.stringify(response.body.nextCursor)}`);
    });
    client.global.set("latestCursor", response.body.nextCursor);
    client.global.set("firstPageId", response.body.items[0].id);
%}

### 5. (커서) 저장한 커서로 다음 페이지 → 첫 페이지 항목이 다시 나오지 않는다
GET {{baseUrl}}/api/v1/stories?sort=latest&limit=1&cursor={{latestCursor}}
Accept: application/json

> {%
    client.test("다음 페이지 조회가 200이다", () => {
        client.assert(response.status === 200, `200이 아닙니다. actual=${response.status}`);
    });
    client.test("첫 페이지와 중복되지 않는다(keyset)", () => {
        const ids = response.body.items.map(it => it.id);
        client.assert(ids.indexOf(client.global.get("firstPageId")) < 0,
            `첫 페이지 항목이 다시 나왔습니다. ids=${ids.join(",")}`);
    });
%}

