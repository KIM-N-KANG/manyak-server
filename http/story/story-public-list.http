    client.test("기본 정렬 조회가 200이다", () => {
        client.assert(response.status === 200, `200이 아닙니다. actual=${response.status}`);
    });
    client.global.set("defaultPopularId", response.body.items[0].id);
%}

### 5-2. (정렬) 명시적 인기순과 기본 정렬 비교, 커서 저장
# 요청 사이 좋아요·턴이 변하지 않는 상태에서 실행하세요. 가중치는 서버 내부 값입니다.
GET {{baseUrl}}/api/v1/stories?sort=popular&limit=1
Accept: application/json

> {%
    client.test("popular가 기본 정렬이다", () => {
        client.assert(response.status === 200, `200이 아닙니다. actual=${response.status}`);
        client.assert(response.body.items[0].id === client.global.get("defaultPopularId"),
            `기본 정렬과 다릅니다. actual=${response.body.items[0].id}`);
        client.assert(typeof response.body.nextCursor === "string",
            `다음 페이지 커서가 없습니다. actual=${response.body.nextCursor}`);
    });
    client.global.set("popularCursor", response.body.nextCursor);
    client.global.set("popularFirstId", response.body.items[0].id);
%}

### 5-3. (커서) 인기순 다음 페이지
GET {{baseUrl}}/api/v1/stories?sort=popular&limit=1&cursor={{popularCursor}}
Accept: application/json

> {%
    client.test("인기순 다음 페이지에 중복이 없다", () => {
        client.assert(response.status === 200, `200이 아닙니다. actual=${response.status}`);
        client.assert(response.body.items.every(it => it.id !== client.global.get("popularFirstId")),
            `첫 페이지 항목이 다시 나왔습니다. actual=${JSON.stringify(response.body.items)}`);
    });
%}

### 6. (정렬) 좋아요순 조회 → 200, likeCount 내림차순
# 좋아요를 심으려면 story-like.http 로 몇 건 등록한 뒤 다시 실행하세요.
GET {{baseUrl}}/api/v1/stories?sort=likes&limit=20
Accept: application/json

> {%
    client.test("좋아요순 조회가 200이다", () => {
        client.assert(response.status === 200, `200이 아닙니다. actual=${response.status}`);
    });
    client.test("likeCount가 내림차순이다", () => {
        const counts = response.body.items.map(it => it.likeCount);
        for (let i = 1; i < counts.length; i++) {
            client.assert(counts[i - 1] >= counts[i], `내림차순이 아닙니다. actual=${counts.join(",")}`);
        }
    });
%}

