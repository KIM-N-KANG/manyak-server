# 누적 턴 수는 미삭제 채팅의 current_turn 합입니다. 턴을 심으려면 chat/chat-turn.http 를 먼저 돌리세요.
GET {{baseUrl}}/api/v1/stories?sort=chats&limit=20
Accept: application/json

> {%
    client.test("채팅순 조회가 200이다", () => {
        client.assert(response.status === 200, `200이 아닙니다. actual=${response.status}`);
    });
    client.test("turnCount가 내림차순이다", () => {
        const counts = response.body.items.map(it => it.turnCount);
        for (let i = 1; i < counts.length; i++) {
            client.assert(counts[i - 1] >= counts[i], `내림차순이 아닙니다. actual=${counts.join(",")}`);
        }
    });
%}

### 6-2. (필터) 오리지널만 조회 → 200
# 공식 계정이 설정된 환경에서는 그 계정 소유 스토리만, 미설정 환경에서는 빈 페이지입니다.
# 위에서 만든 검증 스토리는 공식 계정 소유가 아니므로 여기에 나오면 안 됩니다.
GET {{baseUrl}}/api/v1/stories?filter=original&sort=popular&limit=20
Accept: application/json

> {%
    client.test("오리지널 필터 조회가 200이다", () => {
        client.assert(response.status === 200, `200이 아닙니다. actual=${response.status}`);
    });
    client.test("오리지널 필터의 모든 카드는 isOriginal=true다", () => {
        for (const card of response.body.items) {
            client.assert(card.isOriginal === true, `true여야 합니다. actual=${JSON.stringify(card)}`);
        }
    });
    client.test("방금 만든 검증 스토리는 오리지널에 없다", () => {
        const ids = response.body.items.map(it => it.id);
        client.assert(ids.indexOf(client.global.get("storyIdA")) < 0 && ids.indexOf(client.global.get("storyIdB")) < 0,
            `공식 계정 소유가 아닌 스토리가 섞였습니다. ids=${ids.join(",")}`);
    });
%}

