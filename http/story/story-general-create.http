### 용량 초과 준비: 5MiB 인물 이미지의 draft presign
# 저장소가 설정된 서버에서 실행한다. 아래 파일을 정확히 5242880바이트로 준비하거나
# 실제 파일 크기에 맞춰 presign·PUT 크기를 바꾼다. 6개 참조 합계가 30MiB 이상이어야 기본 예산을 초과한다.
POST {{baseUrl}}/api/v1/stories/images/presign
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"kind":"CHARACTER","contentType":"image/webp","contentLength":5242880}

> {%
client.test("용량 검증 준비", () => client.assert(response.status === 201, `201 기대, actual=${response.status}`));
client.global.set("sizeUploadUrl", response.body.uploadUrl);
client.global.set("sizeObjectKey", response.body.objectKey);
%}

### 파일 업로드 (먼저 로컬 파일 준비)
PUT {{sizeUploadUrl}}
Content-Type: image/webp
Content-Length: 5242880

< ./size-test.webp


### POST 용량 초과: 30MiB × 4/3 + JSON > 40MiB
POST {{baseUrl}}/api/v1/stories/general
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title":"용량 검사", "oneLineIntro":"소개", "genres":["판타지"],
  "storySettings":{"worldSetting":"세계","characterSetting":"인물","userRoleSetting":"역할","ruleSetting":"규칙"},
  "startSettings":[{"name":"시작","prologue":"도입","startSituation":"상황","suggestedInputs":["하나","둘","셋"]}],
  "characters":[{"name":"세린","images":[
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_1"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_2"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_3"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_4"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_5"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_6"}
  ]}]
}

> {%
client.test("검수 요청 전 용량 초과 거절", () => {
  client.assert(response.status === 400, `400 기대, actual=${response.status}`);
  client.assert(response.body.code === "IMAGES_TOO_LARGE", `actual=${response.body.code}`);
});
%}


