### 일반 제작 검수 제출 (§4-3-8, KNK-1161)
# 준비: docker compose up -d, ./gradlew bootRun, auth/auth-login-google.http로 accessToken 설정.
# 순서: 접수 → 알림 수신 후 제출본 조회 → 승인된 createdStoryId로 상세 조회.
# 접수는 DB PENDING만 저장한다. 폴러(기본 1초)가 빈 실행 슬롯에 선점한 뒤 검수한다.
# 로컬 스텁은 폴러 선점 후 자동 승인한다. 반려·실패 복구는 실제 AI 또는 테스트 대역이 필요하다.
@baseUrl = http://localhost:8080

### 서버 확인
GET {{baseUrl}}/actuator/health

### 일반 제작 접수 (회원, 202)
POST {{baseUrl}}/api/v1/stories/general
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "달빛 아래의 계약",
  "oneLineIntro": "기억을 잃은 마법사의 여정",
  "genres": ["판타지"],
  "storySettings": {"worldSetting":"왕국", "characterSetting":"마법사", "userRoleSetting":"추적자", "ruleSetting":"마법에는 대가가 있다"},
  "startSettings": [{"name":"첫날", "prologue":"비가 내린다", "startSituation":"성문 앞", "suggestedInputs":["주변을 본다","문을 연다","말을 건다"], "endings":[]}],
  "characters": [{"name":"세린", "images":[]}]
}

> {%
client.test("검수 제출본 접수", () => {
  client.assert(response.status === 202, `202 기대, actual=${response.status}`);
  client.assert(response.body.status === "PENDING", "PENDING 기대");
  client.assert(!response.body.id, "접수 시 스토리 ID 없음");
});
client.global.set("submissionId", response.body.submissionId);
%}

### 제출본 상세: 알림 수신 또는 화면 재진입 시 한 번 조회
GET {{baseUrl}}/api/v1/stories/submissions/{{submissionId}}
Authorization: Bearer {{accessToken}}

> {%
client.test("제출본 복원", () => {
  client.assert(response.status === 200, `200 기대, actual=${response.status}`);
  client.assert(Array.isArray(response.body.imageErrors), "imageErrors 배열 필수");
  client.assert(response.body.imageErrors.every(e => typeof e.path === "string" &&
    ["IMAGE_DOWNLOAD_FAILED", "IMAGE_INVALID", "IMAGE_UNREADABLE"].includes(e.errorCode) && !("error_code" in e)), "이미지 오류는 path/errorCode");
  client.assert(!("submission" in response.body.payload), "payload에 응답 전용 submission 없음");
  client.assert(response.body.payload.title === "달빛 아래의 계약", "입력 보존");
});
if (response.body.status === "APPROVED") client.global.set("createdStoryId", response.body.storyId);
%}

### 승인 후 상세 (위 조회가 APPROVED일 때 실행)
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}

### 내 미승인 목록 (APPROVED 제외, limit 1~100 보정)
GET {{baseUrl}}/api/v1/stories/submissions?limit=100
Authorization: Bearer {{accessToken}}

> {%
client.test("미승인만 반환", () => {
  client.assert(response.status === 200, `200 기대, actual=${response.status}`);
  client.assert(response.body.every(s => s.status !== "APPROVED"), "승인 제출본 제외");
  client.assert(response.body.every(s => Array.isArray(s.imageErrors)), "목록에도 imageErrors 필수");
});
%}

### CREATE 재제출: REJECTED 또는 FAILED일 때만 실행 (같은 submissionId, 202)
PUT {{baseUrl}}/api/v1/stories/submissions/{{submissionId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "달빛 아래의 계약",
  "oneLineIntro": "기억을 잃은 마법사의 여정",
  "genres": ["판타지"],
  "storySettings": {"worldSetting":"왕국", "characterSetting":"마법사", "userRoleSetting":"추적자", "ruleSetting":"마법에는 대가가 있다"},
  "startSettings": [{"name":"첫날", "prologue":"비가 내린다", "startSituation":"성문 앞", "suggestedInputs":["주변을 본다","문을 연다","말을 건다"], "endings":[]}],
  "characters": [{"name":"세린", "images":[]}]
}

> {% client.test("재제출 또는 상태 충돌", () => client.assert([202,409].includes(response.status), `actual=${response.status}`)); %}

### 미승인 취소: PENDING도 삭제 가능, APPROVED는 409
DELETE {{baseUrl}}/api/v1/stories/submissions/{{submissionId}}
Authorization: Bearer {{accessToken}}

> {% client.test("폐기 상태", () => client.assert([204,409].includes(response.status), `actual=${response.status}`)); %}

