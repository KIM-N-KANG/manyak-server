### 스토리 수정 검수 제출 (§4-3-8)
# 준비: 서버·Postgres 기동, accessToken 설정, story-general-create.http 승인 후 createdStoryId 설정.
# 텍스트 수정은 202, visibility 단독 변경은 PENDING이 없으면 즉시 200.
@baseUrl = http://localhost:8080

### 서버 확인
GET {{baseUrl}}/actuator/health

### 현재 폼: submission은 항상 존재하고 없으면 null
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}

> {% client.test("제출 상태 필드", () => client.assert(response.status === 200 && "submission" in response.body, `actual=${response.status}`)); %}

### 텍스트 수정 접수
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":"달빛 아래의 새 계약"}

> {%
client.test("검수 접수", () => client.assert(response.status === 202, `actual=${response.status}`));
client.global.set("submissionId", response.body.submissionId);
%}

### PENDING 중이면 409 (로컬 즉시 승인 스텁에서는 승인 이후 200일 수 있음)
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"visibility":"PUBLIC"}

> {% client.test("상태별 쓰기", () => client.assert([200,409].includes(response.status), `actual=${response.status}`)); %}

### PENDING 유지 중 무효 본문도 입력 검증보다 409 우선
# 즉시 승인 로컬 스텁에서는 이미 승인되어 400이 될 수 있다. PENDING이 유지되는 AI 대역에서 실행한다.
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"genres":[]}

> {% client.test("PENDING 우선", () => client.assert(response.status === 409, `409 기대, actual=${response.status}`)); %}

### 반려·실패 입력도 수정 폼에 유지된다
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}

> {%
client.test("수정 폼 이미지 오류 계약", () => {
  client.assert(response.status === 200, `actual=${response.status}`);
  const submission = response.body.submission;
  if (submission !== null) {
    client.assert(Array.isArray(submission.imageErrors), "submission.imageErrors 배열 필수");
    client.assert(submission.imageErrors.every(e => typeof e.path === "string" && typeof e.errorCode === "string" && !("error_code" in e)), "camelCase 이미지 오류");
  }
});
%}

# 반려·실패 후 이미지 삭제 시 해당 오류는 제외되고, 남은 이미지 경로는 현재 폼 인덱스로 이동한다.
# PATCH 재제출 후 PENDING에서는 issues/imageErrors가 빈 배열, errorCode는 null이다.

### 검수 알림 뒤 상태 조회
GET {{baseUrl}}/api/v1/stories/submissions/{{submissionId}}
Authorization: Bearer {{accessToken}}

### PENDING이 없을 때 공개 범위만 즉시 변경 (200)
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"visibility":"PRIVATE"}

> {% client.test("공개 범위 변경", () => client.assert(response.status === 200, `actual=${response.status}`)); %}

### 미인증 수정 401
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Content-Type: application/json

{"title":"허용 안 됨"}

> {% client.test("회원 전용", () => client.assert(response.status === 401, `actual=${response.status}`)); %}

### 잘못된 제목 (PENDING이 없을 때 400)
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":" "}

> {% client.test("빈 제목 거절", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 자유 조회
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}


### PATCH 용량 초과 (400 IMAGES_TOO_LARGE)
# story-general-create.http의 용량 준비 presign·파일 PUT부터 실행해 sizeObjectKey를 설정한다.
# PENDING이 없는 내 createdStoryId를 사용한다. 유지되는 라이브 표지·인물 이미지도 합계에 포함한다.
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title":"용량 검사", "oneLineIntro":"소개", "genres":["판타지"],
  "storySettings":{"worldSetting":"세계","characterSetting":"인물","userRoleSetting":"역할","ruleSetting":"규칙"},
  "startSettings":[{"name":"시작","prologue":"도입","startSituation":"상황","suggestedInputs":["하나","둘","셋"]}],
  "characters":[{"name":"세린","images":[
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_1"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_2"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_3"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_4"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_5"},
    {"objectKey":"{{sizeObjectKey}}","imageName":"세린_6"}
  ]}]
}

> {%
client.test("수정 용량 사전 검사", () => {
  client.assert(response.status === 400, `400 기대, actual=${response.status}`);
  client.assert(response.body.code === "IMAGES_TOO_LARGE", `actual=${response.body.code}`);
});
%}

### 인물 소개 수정 준비: PENDING이 없고 인물이 있는 내 스토리로 실행
# story-general-create.http에서 인물이 있는 스토리를 만들고 승인된 createdStoryId를 사용한다.
# 각 PATCH 뒤 검수 완료를 기다린 다음 다음 PATCH를 실행한다. PENDING이면 409가 우선한다.
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}

> {%
client.test("인물 소개 조회", () => {
  client.assert(response.status === 200, `200 기대, actual=${response.status}`);
  const characters = response.body.characters;
  client.assert(characters.length > 0, "인물이 있는 스토리가 필요합니다");
  client.assert(characters.every(c => "description" in c && (c.description === null || typeof c.description === "string")), "description은 string 또는 null이어야 합니다");
  const inputs = characters.map(c => ({id: c.id, name: c.name}));
  client.global.set("descriptionCharacterId", inputs[0].id);
  inputs[0].description = "  왕국을 지키는 기사  ";
  client.global.set("descriptionChangeBody", JSON.stringify({characters: inputs}));
  inputs[0].description = "";
  client.global.set("descriptionDeleteBody", JSON.stringify({characters: inputs}));
  inputs[0].description = "가".repeat(151);
  client.global.set("descriptionInvalidBody", JSON.stringify({characters: inputs}));
});
%}

### 소개 변경 접수: 다른 인물과 이미지는 유지
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{{descriptionChangeBody}}

> {%
client.test("소개 검수 접수", () => client.assert(response.status === 202, `202 기대, actual=${response.status}`));
client.global.set("submissionId", response.body.submissionId);
%}

### 수정 폼은 검수 중에도 제출한 소개를 공백 제거해 반환
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}

> {%
client.test("제출한 소개 표시", () => {
  client.assert(response.status === 200, `200 기대, actual=${response.status}`);
  const character = response.body.characters.find(c => c.id === client.global.get("descriptionCharacterId"));
  client.assert(character.description === "왕국을 지키는 기사", `actual=${character.description}`);
});
%}

### 소개 변경 승인 후 상세 확인
# 제출본 상태가 APPROVED가 된 뒤 실행한다. AI 수신 지원이 먼저 배포되어 있어야 한다.
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}

> {% client.test("승인 소개 반영", () => client.assert(response.status === 200 && response.body.characters.some(c => c.description === "왕국을 지키는 기사"), "승인 후 상세 소개를 확인하세요")); %}

### 소개 삭제 접수: 변경 검수 완료 뒤 실행
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{{descriptionDeleteBody}}

> {% client.test("소개 삭제 검수 접수", () => client.assert(response.status === 202, `202 기대, actual=${response.status}`)); %}

### 수정 폼 소개 삭제 확인
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}

> {%
client.test("빈 소개는 null", () => {
  client.assert(response.status === 200, `200 기대, actual=${response.status}`);
  const character = response.body.characters.find(c => c.id === client.global.get("descriptionCharacterId"));
  client.assert(character.description === null, `null 기대, actual=${character.description}`);
});
%}

### 소개 151자는 400: 삭제 검수 완료 뒤 실행
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{{descriptionInvalidBody}}

> {% client.test("소개 길이 검증", () => client.assert(response.status === 400, `400 기대, actual=${response.status}`)); %}


### 새 미제공 장르 추가 거절 (PENDING 제출본이 없을 때 실행)
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"genres":["BL","새로운미제공장르"]}

> {%
client.test("PATCH 신규 무효 장르", () => {
  client.assert(response.status === 400 && response.body.code === "INVALID_GENRE", `actual=${response.status}/${response.body.code}`);
  client.assert(response.body.details[0].field === "genres[1]", "인덱스 불일치");
});
%}

### 기존 라이브 장르 보존 준비
# createdStoryId를 커스텀 장르가 저장된 본인 스토리로 바꾸면 과거 장르 보존도 확인 가능하다.
# 최신 제출본이 있으면 폼은 미승인 값을 덧씌우므로 승인 완료 후 실행한다.
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}

> {%
client.test("라이브 폼 준비", () => {
  client.assert(response.status === 200 && response.body.submission === null, "승인된 라이브 폼 필요");
  const genres = [...response.body.genres];
  if (!genres.includes("BL") && genres.length < 8) genres.push("BL");
  client.global.set("preservedGenresJson", JSON.stringify(genres));
});
%}

### 기존 커스텀은 유지하고 새 제공 장르를 추가
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"genres":{{preservedGenresJson}}}

> {% client.test("기존 장르 보존 수정 접수", () => client.assert(response.status === 202, `actual=${response.status}`)); %}

### 자유 조회 (검수 승인 후 장르 확인)
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}
