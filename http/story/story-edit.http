### 스토리 수정 검수 제출 (§4-3-8)
# 준비: 서버·Postgres 기동, accessToken 설정, story-general-create.http 승인 후 createdStoryId 설정.
# 텍스트 수정은 202, visibility 단독 변경은 PENDING이 없으면 즉시 200.
@baseUrl = http://localhost:8080

### 서버 확인
GET {{baseUrl}}/actuator/health

### 현재 폼: submission은 항상 존재하고 없으면 null
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}

> {% client.test("제출 상태 필드", () => client.assert(response.status === 200 && "submission" in response.body, `actual=${response.status}`)); %}

### 텍스트 수정 접수
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":"달빛 아래의 새 계약"}

> {%
client.test("검수 접수", () => client.assert(response.status === 202, `actual=${response.status}`));
client.global.set("submissionId", response.body.submissionId);
%}

### PENDING 중이면 409 (로컬 즉시 승인 스텁에서는 승인 이후 200일 수 있음)
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"visibility":"PUBLIC"}

> {% client.test("상태별 쓰기", () => client.assert([200,409].includes(response.status), `actual=${response.status}`)); %}

### PENDING 유지 중 무효 본문도 입력 검증보다 409 우선
# 즉시 승인 로컬 스텁에서는 이미 승인되어 400이 될 수 있다. PENDING이 유지되는 AI 대역에서 실행한다.
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"genres":[]}

> {% client.test("PENDING 우선", () => client.assert(response.status === 409, `409 기대, actual=${response.status}`)); %}

### 반려·실패 입력도 수정 폼에 유지된다
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}

### 검수 알림 뒤 상태 조회
GET {{baseUrl}}/api/v1/stories/submissions/{{submissionId}}
Authorization: Bearer {{accessToken}}

### PENDING이 없을 때 공개 범위만 즉시 변경 (200)
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"visibility":"PRIVATE"}

> {% client.test("공개 범위 변경", () => client.assert(response.status === 200, `actual=${response.status}`)); %}

### 미인증 수정 401
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Content-Type: application/json

{"title":"허용 안 됨"}

> {% client.test("회원 전용", () => client.assert(response.status === 401, `actual=${response.status}`)); %}

### 잘못된 제목 (PENDING이 없을 때 400)
PATCH {{baseUrl}}/api/v1/stories/{{createdStoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":" "}

> {% client.test("빈 제목 거절", () => client.assert(response.status === 400, `actual=${response.status}`)); %}

### 자유 조회
GET {{baseUrl}}/api/v1/stories/{{createdStoryId}}/edit
Authorization: Bearer {{accessToken}}
