### KNK-1795 채팅 모델·출력 분량 설정 검증 (IntelliJ HTTP Client)
# 준비: docker compose up -d postgres redis, AI 서버 기동, ./gradlew bootRun
# chat-create.http의 스토리 준비 1~2를 먼저 실행해 storyId를 저장한다.
# 순서대로 실행. 회원 소유권 검증은 로그인 파일로 accessToken을 저장한다.
@baseUrl = http://localhost:8080

### 0. 상태 확인
GET {{baseUrl}}/actuator/health

### 1. 인증 없이 활성 모델 목록과 기본 모델 확인
GET {{baseUrl}}/api/v1/chats/models

> {%
    client.test("모델 목록", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        const rows = response.body;
        const defaults = rows.filter(m => m.isDefault);
        client.assert(defaults.length === 1, `기본 모델 수 actual=${defaults.length}`);
        client.assert(rows.every(m => typeof m.code === "string" && m.turnCost > 0), "코드/가격 오류");
        client.global.set("defaultChatModel", defaults[0].code);
    });
%}

### 2. 게스트 채팅 생성: 기본 모델은 모델 목록이 기준
POST {{baseUrl}}/api/v1/chats
Content-Type: application/json

{"storyId":"{{storyId}}"}

> {%
    client.test("기본 모델", () => {
        client.assert(response.status === 201, `actual=${response.status}`);
        client.assert(response.body.longResponse === false, `longResponse actual=${response.body.longResponse}`);
        client.assert(response.body.model === client.global.get("defaultChatModel"), `actual=${response.body.model}`);
    });
    client.global.set("modelChatId", response.body.id);
%}

### 3. 생성 중에도 변경 가능, 다음 턴부터 적용 (게스트 턴 AI는 항상 LITE)
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Content-Type: application/json

{"model":"LITE"}

> {%
    client.test("모델 변경", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        client.assert(response.body.model === "LITE", `actual=${response.body.model}`);
    });
%}

### 4. 상세에도 유효 모델
GET {{baseUrl}}/api/v1/chats/{{modelChatId}}

> {%
    client.test("상세 모델", () => {
        client.assert(response.status === 200 && response.body.model === "LITE", `actual=${response.status}, ${response.body.model}`);
    });
%}

### 5. 미지원 모델은 400 (비활성 모델도 동일)
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Content-Type: application/json

{"model":"UNKNOWN"}

> {% client.test("400", () => { client.assert(response.status === 400, `actual=${response.status}`); }); %}

### 6. 누락은 400
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Content-Type: application/json

{}

> {% client.test("누락 400", () => { client.assert(response.status === 400, `actual=${response.status}`); }); %}

### 7. 회원은 게스트 소유 채팅을 변경할 수 없다 (로그인 준비 필요)
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"model":"AURORA"}

> {% client.test("403", () => { client.assert(response.status === 403, `actual=${response.status}`); }); %}

### 8. 형식 오류/미존재/삭제는 404
PATCH {{baseUrl}}/api/v1/chats/invalid-id
Content-Type: application/json

{"model":"LITE"}

> {% client.test("404", () => { client.assert(response.status === 404, `actual=${response.status}`); }); %}

### 9. 출력 분량만 켜기: 모델 유지
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Content-Type: application/json

{"longResponse":true}

> {%
    client.test("출력 분량만 변경", () => {
        client.assert(response.status === 200, `actual=${response.status}`);
        client.assert(response.body.model === "LITE" && response.body.longResponse === true,
            `actual=${JSON.stringify(response.body)}`);
    });
%}

### 10. 기존 모델 요청은 출력 분량 유지
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Content-Type: application/json

{"model":"AURORA"}

> {%
    client.test("모델만 변경", () => {
        client.assert(response.status === 200 && response.body.longResponse === true,
            `actual=${JSON.stringify(response.body)}`);
    });
%}

### 11. 상세 재조회에도 출력 분량 유지
GET {{baseUrl}}/api/v1/chats/{{modelChatId}}

> {%
    client.test("저장된 설정", () => {
        client.assert(response.status === 200 && response.body.model === "AURORA" && response.body.longResponse === true,
            `actual=${JSON.stringify(response.body)}`);
    });
%}

### 12. 모델과 출력 분량 함께 변경
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Content-Type: application/json

{"model":"LITE","longResponse":false}

> {%
    client.test("두 설정 변경", () => {
        client.assert(response.status === 200 && response.body.model === "LITE" && response.body.longResponse === false,
            `actual=${JSON.stringify(response.body)}`);
    });
%}

### 13. 명시적 null은 400
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Content-Type: application/json

{"longResponse":null}

> {%
    client.test("출력 분량 null 400", () => {
        client.assert(response.status === 400, `actual=${response.status}`);
        client.assert(response.body.code === "BAD_REQUEST", `code actual=${response.body.code}`);
        client.assert(response.body.message === "요청 값이 올바르지 않습니다.", `message actual=${response.body.message}`);
        client.assert(Array.isArray(response.body.details) && response.body.details.length === 0,
            `details actual=${JSON.stringify(response.body.details)}`);
    });
%}

### 14. 다른 필드가 있어도 null 모델은 400
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Content-Type: application/json

{"model":null,"longResponse":true}

> {%
    client.test("모델 null 400", () => {
        client.assert(response.status === 400, `actual=${response.status}`);
        client.assert(response.body.code === "BAD_REQUEST", `code actual=${response.body.code}`);
        client.assert(response.body.message === "요청 값이 올바르지 않습니다.", `message actual=${response.body.message}`);
        client.assert(Array.isArray(response.body.details) && response.body.details.length === 0,
            `details actual=${JSON.stringify(response.body.details)}`);
    });
%}

### 15. 회원은 게스트 출력 분량을 바꿀 수 없다 (로그인 준비 필요)
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"longResponse":true}

> {%
    client.test("출력 분량 소유권 403", () => {
        client.assert(response.status === 403, `actual=${response.status}`);
        client.assert(response.body.code === "FORBIDDEN", `code actual=${response.body.code}`);
        client.assert(response.body.message === "채팅을 이어쓸 권한이 없습니다.", `message actual=${response.body.message}`);
    });
%}

### 16. 청구 모델 검증: 게스트 선택 모델을 AURORA로 준비
PATCH {{baseUrl}}/api/v1/chats/{{modelChatId}}
Content-Type: application/json

{"model":"AURORA"}

> {%
    client.test("게스트 선택 모델", () => {
        client.assert(response.status === 200 && response.body.model === "AURORA", `actual=${JSON.stringify(response.body)}`);
        client.global.set("billingModelDeviceId", "billing-model-" + Date.now());
    });
%}

### 17. 게스트 턴 저장: AI 응답 model_code=LITE, 사용자 입력=NULL
POST {{baseUrl}}/api/v1/chats/{{modelChatId}}/turns/stream
X-Manyak-Device-Id: {{billingModelDeviceId}}
Content-Type: application/json
Accept: text/event-stream

{"userInput":"주변을 살펴본다.","realtimeImage":false}

# SSE completed 뒤 아래 SQL을 로컬/검증 DB에서 실행한다. model_code는 공개 응답 필드가 아니다.
# SELECT m.id,m.role,m.model_code,m.credit_transaction_id,m.created_at,c.model_code AS selected_model
# FROM story_messages m JOIN story_chats c ON c.id=m.chat_id
# WHERE c.public_id='<modelChatId UUID>'::uuid ORDER BY m.message_order;
# 기대: USER NULL, ASSISTANT LITE, selected_model AURORA. 게스트 credit_transaction_id는 NULL.

### 18. 회원 청구 모델 검증용 채팅 생성 (accessToken 필요)
POST {{baseUrl}}/api/v1/chats
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"storyId":"{{storyId}}"}

> {%
    client.test("회원 채팅 생성", () => {
        client.assert(response.status === 201, `actual=${response.status}`);
        client.global.set("billingMemberChatId", response.body.id);
    });
%}

### 19. 첫 턴은 LITE로 준비
PATCH {{baseUrl}}/api/v1/chats/{{billingMemberChatId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"model":"LITE"}

> {% client.test("LITE 설정", () => { client.assert(response.status === 200 && response.body.model === "LITE", `actual=${JSON.stringify(response.body)}`); }); %}

### 20. 회원 LITE 턴 생성 — completed 이후 진행
POST {{baseUrl}}/api/v1/chats/{{billingMemberChatId}}/turns/stream
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: text/event-stream

{"userInput":"주변을 살펴본다.","realtimeImage":false}

### 21. 저장된 턴 ID 확보
GET {{baseUrl}}/api/v1/chats/{{billingMemberChatId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("LITE 턴 저장", () => {
        client.assert(response.status === 200 && response.body.turns.length === 1, `actual=${JSON.stringify(response.body)}`);
        client.global.set("billingMemberTurnId", response.body.turns[0].id);
    });
%}

### 22. AURORA로 설정 변경 — 기존 응답의 model_code는 LITE 유지
PATCH {{baseUrl}}/api/v1/chats/{{billingMemberChatId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"model":"AURORA"}

> {% client.test("AURORA 설정", () => { client.assert(response.status === 200 && response.body.model === "AURORA", `actual=${JSON.stringify(response.body)}`); }); %}
# 17의 SQL에 billingMemberChatId를 넣어 USER NULL, ASSISTANT LITE, selected_model AURORA를 확인한다.
# admin/metrics.http에서 해당 날짜 byModel은 AURORA, turnsByModel은 LITE임을 확인한다.

### 23. AURORA 재생성 — 잔액 필요, completed 뒤 동일 메시지의 model_code=AURORA
POST {{baseUrl}}/api/v1/chats/{{billingMemberChatId}}/turns/regenerate/stream
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: text/event-stream

{"turnId":{{billingMemberTurnId}},"realtimeImage":false}

# 같은 메시지 id·created_at 유지, model_code=AURORA 및 새 credit_transaction_id를 확인한다.
# USER는 NULL, 이전 응답은 story_message_versions에 보관. turnsByModel 합은 그대로이고 활성본만 AURORA로 이동한다.
# AI 실패 시 본문·청구 모델·차감 연결 모두 기존 값 유지, 새 차감은 환불된다.
# 마이그레이션 전 메시지는 NULL 유지(백필 없음), 관리자 집계에서 UNRECORDED로 표시된다.

### 자유 조회
GET {{baseUrl}}/api/v1/chats/models
