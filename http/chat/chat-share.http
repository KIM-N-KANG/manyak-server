GET {{baseUrl}}/api/v1/shares/999999999
Accept: application/json

> {%
    client.test("형식 오류 shareId도 404다", () => {
        client.assert(response.status === 404, `404가 아닙니다. actual=${response.status}`);
        client.assert(response.body.message === "공유를 찾을 수 없습니다.", `메시지가 다릅니다. actual=${response.body.message}`);
    });
%}

