<?xml version="1.0" encoding="UTF-8"?>
<!--
  운영 로그 양식(AN-3 §4).
  - prod·dev 프로파일: JSON 1줄 로그(LogstashEncoder). MDC(request_id/session_id/device_id_hash)와
    StructuredArguments(event_name 등)를 최상위 필드로 내보내 CloudWatch에서 그대로 질의한다.
    개발도 CloudWatch Logs로 나가고, 개발 환경의 존재 이유가 운영 배포 리허설이라
    prod용 CloudWatch Insights 쿼리를 개발에서 그대로 리허설할 수 있어야 한다(KNK-828).
  - 그 외(local/test 등): 사람이 읽기 쉬운 Spring Boot 기본 콘솔 패턴 유지.
    아래 두 블록의 조건은 **반드시 서로 배타적**이어야 한다. 한쪽만 dev를 더하면 dev에서 JSON·CONSOLE
    두 appender가 동시에 붙어 로그가 2줄씩 찍힌다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="prod,dev">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"manyak-server"}</customFields>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="!prod &amp; !dev">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
